{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newsnext-instance",
  "compatibility_date": "2025-12-19",
  "workers_dev": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "instance.newsnext.pro",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "CACHE_DB",
      "database_name": "newsnext-cache",
      "database_id": "7c7b6739-9dc4-4f3f-a480-ec1816ddebbc"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
