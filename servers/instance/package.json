{
  "name": "@newsnext/instance",
  "type": "module",
  "private": true,
  "description": "Data fetching instance for NewsNext sources",
  "license": "MPL-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./local": "./src/local.ts",
    "./runtime": "./src/runtime.ts",
    "./source-loader": "./src/source-loader.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "nitro dev --port 4001",
    "build": "nitro build --preset bun",
    "build:bun": "nitro build --preset bun",
    "preview": "nitro preview",
    "test": "cd ../.. && bun run vitest --run servers/instance/src/source-loader.test.ts",
    "typecheck": "tsgo -b"
  },
  "dependencies": {
    "@newsnext/shared": "workspace:*",
    "@newsnext/sources": "workspace:*"
  },
  "devDependencies": {
    "nitro": "3.0.260522-beta"
  }
}
