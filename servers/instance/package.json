{
  "name": "@newsnext/instance",
  "type": "module",
  "private": true,
  "description": "Data fetching instance for NewsNext sources",
  "license": "MPL-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./local": "./src/local.ts",
    "./remote": "./src/remote.ts",
    "./runtime": "./src/runtime.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "nitro dev --port 4001",
    "build": "nitro build --preset bun",
    "build:bun": "nitro build --preset bun",
    "build:cloudflare": "nitro build --preset cloudflare_module",
    "build:vercel": "nitro build --preset vercel",
    "deploy:cloudflare": "nitro deploy --preset cloudflare_module",
    "deploy:vercel": "nitro deploy --preset vercel",
    "preview": "nitro preview",
    "typecheck": "tsgo -b"
  },
  "dependencies": {
    "@newsnext/cache": "workspace:*",
    "@newsnext/shared": "workspace:*",
    "@newsnext/sources": "workspace:*",
    "db0": "^0.3.4"
  },
  "devDependencies": {
    "nitro": "3.0.260522-beta"
  }
}
