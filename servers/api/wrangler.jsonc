{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newsnext-api",
  "compatibility_date": "2025-12-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://api.newsnext.pro",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://newsnext.pro,chrome-extension://cffgbnjiaakknooiegnjkojemhidheke",
    "GITHUB_CLIENT_ID": "Ov23lizGxoGltuEXdplC"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GITHUB_CLIENT_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ]
  },
  "routes": [
    {
      "pattern": "api.newsnext.pro",
      "custom_domain": true
    }
  ],
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  "r2_buckets": [
    {
      "binding": "ICON_BUCKET",
      "bucket_name": "newsnext"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newsnext-db",
      "database_id": "17b001f5-1b84-4304-9239-31f4a7e5b96f"
    }
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
