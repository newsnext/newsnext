{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newsnext",
  "main": "dist/index.cf.mjs",
  "compatibility_date": "2025-12-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "public"
  },
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  "r2_buckets": [
    {
      "binding": "ICON_BUCKET",
      "bucket_name": "newsnext"
    }
  ],
  "d1_databases": [
    {
      "binding": "CACHE_DB",
      "database_name": "newsnext-cache",
      "database_id": "7c7b6739-9dc4-4f3f-a480-ec1816ddebbc"
    },
    {
      "binding": "DATA_DB",
      "database_name": "newsnext-data",
      "database_id": "d57ded3d-72e3-47c8-a72b-4bc2501ce410"
    }
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}