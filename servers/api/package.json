{
  "name": "@newsnext/api",
  "type": "module",
  "private": true,
  "license": "MPL-2.0",
  "exports": {
    "./trpc": "./src/routes/trpc/app-router.ts"
  },
  "scripts": {
    "dev": "nitro dev --port 4000",
    "build": "nitro build --preset bun",
    "build:bun": "nitro build --preset bun",
    "build:cloudflare": "nitro build --preset cloudflare_module",
    "build:vercel": "nitro build --preset vercel",
    "build:web": "bun run build.ts",
    "deploy:cloudflare": "nitro deploy --preset cloudflare_module",
    "deploy:vercel": "nitro deploy --preset vercel",
    "preview": "nitro preview",
    "cf:typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@newsnext/database": "workspace:*",
    "@newsnext/instance": "workspace:*",
    "@newsnext/sources": "workspace:*",
    "@trpc/server": "^11.16.0",
    "better-auth": "^1.6.9",
    "db0": "^0.3.4"
  },
  "devDependencies": {
    "nitro": "3.0.260522-beta"
  }
}
