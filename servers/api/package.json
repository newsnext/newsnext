{
  "name": "@newsnext/api",
  "type": "module",
  "private": true,
  "license": "MPL-2.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "tsdown src/index.ts --outDir dist --dts",
    "build:cf": "bun run build && cd ../../apps/extension && bun run build:web --outDir ../../servers/api/public",
    "cf:typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.1",
    "@newsnext/cache": "workspace:*",
    "@newsnext/database": "workspace:*",
    "@newsnext/sources": "workspace:*",
    "@trpc/server": "^11.8.0",
    "hono": "catalog:"
  }
}