{
  "name": "@newsnext/cli",
  "type": "module",
  "version": "1.0.0-beta.1",
  "private": true,
  "license": "MPL-2.0",
  "bin": {
    "newsnext": "./dist/newsnext.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build src/index.ts --target node --outfile dist/newsnext.js",
    "dev": "bun run src/index.ts restart",
    "newsnext": "bun run src/index.ts",
    "test": "vitest run --root ../.. apps/cli",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@newsnext/extension-connection": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "citty": "^0.2.2",
    "hono": "^4.13.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@newsnext/tsconfigs": "workspace:*",
    "@types/ws": "^8.18.1",
    "vitest": "catalog:"
  }
}
