{
  "name": "@newsnext/extension",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "manifest.json description",
  "scripts": {
    "dev": "bun run dev:web",
    "build": "bun run build:web",
    "dev:web": "bun run --bun vite",
    "scan:web": "react-scan http://localhost:3001",
    "build:web": "bun run --bun vite build",
    "preview": "bun run --bun vite preview",
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip:chrome": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsgo --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.1.5",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@chenglou/pretext": "^0.0.6",
    "@newsnext/feeds": "workspace:*",
    "@newsnext/ui": "workspace:*",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-router": "^1.168.24",
    "@tanstack/react-virtual": "^3.13.24",
    "@trpc/client": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@webext-core/messaging": "^2.3.0",
    "@webext-core/proxy-service": "^2.0.0",
    "date-fns": "^4.1.0",
    "defu": "^6.1.7",
    "es-toolkit": "^1.46.0",
    "jotai": "^2.19.1",
    "lucide-react": "^1.11.0",
    "motion": "^12.38.0",
    "ofetch": "^1.5.1",
    "react": "catalog:",
    "react-device-detect": "^2.2.3",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@newsnext/api": "workspace:*",
    "@newsnext/shared": "workspace:*",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query-devtools": "^5.100.5",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/router-plugin": "^1.167.27",
    "@vitejs/plugin-react": "^6.0.1",
    "react-scan": "^0.5.3",
    "tailwindcss": "catalog:",
    "unplugin-icons": "^23.0.1",
    "unplugin-turbo-console": "^2.3.1",
    "vite": "^8.0.10",
    "wxt": "^0.20.25"
  }
}
