{
  "name": "@newsnext/extension",
  "type": "module",
  "version": "1.0.0-beta.3",
  "private": true,
  "description": "manifest.json description",
  "scripts": {
    "dev": "bun run dev:chrome",
    "dev:yolo": "WXT_YOLO_MODE=true bun run dev",
    "build": "bun run build:chrome",
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "test": "bun run --cwd ../.. test -- apps/extension",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip:chrome": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc -b --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "catalog:",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "catalog:",
    "@newsnext/extension-connection": "workspace:*",
    "@newsnext/registry": "workspace:*",
    "@newsnext/shared": "workspace:*",
    "@newsnext/source-kit": "workspace:*",
    "@newsnext/ui": "workspace:*",
    "@tanstack/query-persist-client-core": "catalog:",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@webext-core/messaging": "^4.0.0",
    "@webext-core/proxy-service": "^3.0.2",
    "canvas-confetti": "^1.9.4",
    "date-fns": "catalog:",
    "defu": "catalog:",
    "dexie": "^4.4.3",
    "es-toolkit": "catalog:",
    "fast-xml-parser": "^5.10.1",
    "gridstack": "catalog:",
    "jotai": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "nanoid": "^6.0.1",
    "path-to-regexp": "^8.4.2",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@iconify-json/ph": "catalog:",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@types/babel__core": "^7.20.5",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "react-cosmos": "^7.3.0",
    "react-cosmos-plugin-vite": "^7.3.0",
    "react-cosmos-ui": "^7.3.0",
    "react-scan": "^0.5.7",
    "tailwindcss": "catalog:",
    "unplugin-icons": "catalog:",
    "unplugin-turbo-console": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wxt": "^0.21.3"
  }
