{
  "name": "@newsnext/extension",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "manifest.json description",
  "scripts": {
    "dev": "bun run dev:chrome",
    "build": "bun run build:chrome",
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip:chrome": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsgo --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "catalog:",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "catalog:",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "catalog:",
    "@newsnext/client-source": "workspace:*",
    "@newsnext/ui": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@webext-core/messaging": "^3.0.2",
    "@webext-core/proxy-service": "^2.0.1",
    "date-fns": "catalog:",
    "defu": "catalog:",
    "es-toolkit": "catalog:",
    "idb": "^8.0.3",
    "jotai": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "ofetch": "catalog:",
    "path-to-regexp": "^8.4.2",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/ph": "catalog:",
    "@newsnext/shared": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "unplugin-icons": "catalog:",
    "unplugin-turbo-console": "catalog:",
    "vite": "catalog:",
    "wxt": "^0.20.26"
  }
