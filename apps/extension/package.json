{
  "name": "@newsnext/extension",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "manifest.json description",
  "scripts": {
    "dev": "bun run dev:chrome",
    "dev:yolo": "WXT_YOLO_MODE=true bun run dev",
    "build": "bun run build:chrome",
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "test": "bun run --cwd ../.. test -- apps/extension",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip:chrome": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc -b --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "catalog:",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "catalog:",
    "@newsnext/registry": "workspace:*",
    "@newsnext/source": "workspace:*",
    "@newsnext/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@webext-core/messaging": "^4.0.0",
    "@webext-core/proxy-service": "^3.0.2",
    "canvas-confetti": "^1.9.4",
    "date-fns": "catalog:",
    "defu": "catalog:",
    "es-toolkit": "catalog:",
    "idb": "^8.0.3",
    "jotai": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "path-to-regexp": "^8.4.2",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/ph": "catalog:",
    "@newsnext/shared": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "catalog:",
    "react-cosmos": "^7.3.0",
    "react-cosmos-plugin-vite": "^7.3.0",
    "react-cosmos-ui": "^7.3.0",
    "tailwindcss": "catalog:",
    "unplugin-icons": "catalog:",
    "unplugin-turbo-console": "catalog:",
    "vite": "catalog:",
    "wxt": "^0.21.3"
  }
}
