{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./tsconfig.wxt.tsbuildinfo",
    "jsx": "react-jsx",
    "paths": {
      "#/*": [
        "./wxt/*"
      ],
      "@/*": [
        "./shared/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "./wxt",
    "./shared",
    "./.wxt/wxt.d.ts"
  ],
  "exclude": [
    "./web"
  ]
}
