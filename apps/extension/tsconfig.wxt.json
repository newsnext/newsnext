{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./tsconfig.wxt.tsbuildinfo",
    "jsx": "react-jsx",
    "paths": {
      "#/*": [
        "./src/*"
      ],
      "@/*": [
        "../web/src/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "./src",
    "../web/src",
    "./.wxt/wxt.d.ts"
  ]
}
