{
  "title": "AIHot",
  "category": "news",
  "color": "blue",
  "defaults": {
    "baseUrl": "https://aihot.virxact.com/",
    "metadata": {
      "home": "/"
    }
  },
  "sources": {
    "all": {
      "loader": {
        "type": "json",
        "url": "/api/public/items?mode=all&take=30",
        "items": "items[?id && title && url]",
        "fields": {
          "title": "title",
          "url": "url",
          "publishedAt": {
            "select": "publishedAt",
            "template": "{{ scope.value | date_to_ms }}"
          },
          "attributes": {
            "source": "source",
            "category": "category"
          },
          "content": {
            "text": "summary"
          }
        },
        "itemTemplate": {
          "inline": "{{ scope.item.attributes.source }}{% if scope.item.attributes.category %} · {{ scope.item.attributes.category }}{% endif %}"
        }
      },
      "cache": "5m"
    }
  }
}
