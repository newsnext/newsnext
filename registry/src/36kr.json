{
  "title": "36氪",
  "category": "news",
  "color": "blue",
  "icon": "https://36kr.com/favicon.ico",
  "defaults": {
    "baseUrl": "https://36kr.com/",
    "vars": {
      "gateway": "https://gateway.36kr.com",
      "newsflashCategories": {
        "0": "全部",
        "1": "热点",
        "2": "股市",
        "3": "公司",
        "4": "宏观"
      }
    },
    "metadata": {
      "home": "/"
    }
  },
  "sources": {
    "information": {
      "metadata": {
        "title": "资讯"
      },
      "params": {
        "channel": {
          "type": "select",
          "title": "栏目",
          "values": [
            {
              "label": "最新",
              "value": "web_news"
            },
            {
              "label": "推荐",
              "value": "web_recommend"
            },
            {
              "label": "创投",
              "value": "contact"
            },
            {
              "label": "财经",
              "value": "ccs"
            },
            {
              "label": "汽车",
              "value": "travel"
            },
            {
              "label": "AI",
              "value": "AI"
            },
            {
              "label": "科技",
              "value": "technology"
            },
            {
              "label": "专精特新",
              "value": "shuzihua"
            },
            {
              "label": "创新",
              "value": "innovate"
            },
            {
              "label": "企服",
              "value": "enterpriseservice"
            },
            {
              "label": "消费",
              "value": "happy_life"
            },
            {
              "label": "城市",
              "value": "real_estate"
            },
            {
              "label": "职场",
              "value": "web_zhichang"
            }
          ],
          "default": "web_news"
        }
      },
      "radar": [
        {
          "id": "36kr-information",
          "match": {
            "hosts": [
              "36kr.com"
            ],
            "paths": [
              "/information/:channel",
              "/information/:channel/*rest"
            ]
          },
          "patch": {
            "params": {
              "channel": "{{ scope.path.channel }}"
            }
          }
        }
      ],
      "loader": {
        "type": "json",
        "url": "{{ source.vars.gateway }}/api/mis/nav/ifm/subNav/flow",
        "fetchOptions": {
          "method": "POST",
          "json": {
            "partner_id": "web",
            "param": {
              "subnavType": 1,
              "subnavNick": "{{ scope.params.channel }}",
              "pageSize": 30,
              "pageEvent": 0,
              "siteId": 1,
              "platformId": 2
            }
          }
        },
        "items": "data.itemList[?itemType == `10`]",
        "fields": {
          "title": "templateMaterial.widgetTitle",
          "url": {
            "select": "itemId",
            "template": "/p/{{ scope.value }}"
          },
          "publishedAt": "templateMaterial.publishTime",
          "author": {
            "name": "templateMaterial.authorName"
          },
          "content": {
            "text": "templateMaterial.summary",
            "pictures": "templateMaterial.widgetImage"
          }
        }
      }
    },
    "newsflashes": {
      "metadata": {
        "title": "快讯"
      },
      "params": {
        "category": {
          "type": "select",
          "title": "分类",
          "values": [
            {
              "label": "全部",
              "value": "0"
            },
            {
              "label": "热点",
              "value": "1"
            },
            {
              "label": "股市",
              "value": "2"
            },
            {
              "label": "公司",
              "value": "3"
            },
            {
              "label": "宏观",
              "value": "4"
            }
          ],
          "default": "0"
        }
      },
      "radar": [
        {
          "id": "36kr-newsflashes",
          "match": {
            "hosts": [
              "36kr.com"
            ],
            "paths": [
              "/newsflashes",
              "/newsflashes/:id",
              "/newsflashes/catalog/:type"
            ]
          },
          "patch": {
            "params": {
              "category": "{{ scope.path.type }}"
            },
            "metadata": {
              "title": "快讯 | {{ source.vars.newsflashCategories[scope.params.category] | default: '全部' }}"
            }
          }
        }
      ],
      "loader": {
        "type": "json",
        "url": "{{ source.vars.gateway }}/api/mis/nav/newsflash/flow",
        "fetchOptions": {
          "method": "POST",
          "json": {
            "partner_id": "web",
            "param": {
              "siteId": 1,
              "platformId": 2,
              "pageSize": 20,
              "pageEvent": 0,
              "type": "{{ scope.params.category }}"
            }
          }
        },
        "items": "data.itemList[?itemType == `20`]",
        "fields": {
          "title": "templateMaterial.widgetTitle",
          "url": {
            "select": "itemId",
            "template": "/newsflashes/{{ scope.value }}"
          },
          "publishedAt": "templateMaterial.publishTime",
          "content": {
            "text": "templateMaterial.widgetContent"
          }
        }
      }
    },
    "hot-list": {
      "version": 3,
      "metadata": {
        "title": "人气榜",
        "home": "/hot-list/catalog",
        "type": "ranking"
      },
      "radar": [
        {
          "id": "36kr-hot-list",
          "match": {
            "hosts": [
              "36kr.com"
            ],
            "paths": [
              "/hot-list/*rest"
            ]
          }
        }
      ],
      "loader": {
        "type": "json",
        "url": "{{ source.vars.gateway }}/api/mis/x/rank/list",
        "fetchOptions": {
          "method": "POST",
          "json": {
            "partner_id": "web",
            "param": {
              "siteId": 1,
              "platformId": 2
            }
          }
        },
        "items": "data.topList",
        "fields": {
          "title": "widgetTitle",
          "url": {
            "select": "itemId",
            "template": "/p/{{ scope.value }}"
          },
          "publishedAt": "publishTime",
          "author": {
            "name": "authorName"
          },
          "attributes": {
            "heat": "statHot"
          },
          "content": {
            "text": "summary",
            "pictures": "widgetImage"
          }
        },
        "inlineTemplate": "{{ scope.item.attributes.heat }}w heat · {{ scope.item.author.name }}"
      }
    }
  }
}
