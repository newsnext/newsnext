{
  "title": "GitHub",
  "category": "developer",
  "color": "slate",
  "defaults": {
    "baseUrl": "https://github.com/",
    "metadata": {
      "home": "/trending"
    }
  },
  "sources": {
    "trending": {
      "version": 4,
      "metadata": {
        "title": "Trending",
        "type": "ranking"
      },
      "params": {
        "language": {
          "type": "text",
          "title": "Language",
          "description": "Programming language slug used by GitHub Trending, such as javascript, go, or rust.",
          "default": ""
        },
        "spokenLanguage": {
          "type": "text",
          "title": "Spoken Language",
          "description": "Repository description language code, such as en, zh, or ja.",
          "default": ""
        },
        "dateRange": {
          "type": "select",
          "title": "Date range",
          "values": [
            {
              "label": "Today",
              "value": "daily"
            },
            {
              "label": "This week",
              "value": "weekly"
            },
            {
              "label": "This month",
              "value": "monthly"
            }
          ],
          "default": "daily"
        }
      },
      "radar": [
        {
          "id": "github-trending",
          "match": {
            "hosts": [
              "github.com"
            ],
            "paths": [
              "/trending",
              "/trending/:language"
            ]
          },
          "patch": {
            "params": {
              "language": "{{ scope.path.language }}",
              "spokenLanguage": "{{ scope.query.spoken_language_code }}",
              "dateRange": "{{ scope.query.since }}"
            },
            "metadata": {
              "title": "Trending {{ scope.params.language }}"
            }
          }
        }
      ],
      "loader": {
        "type": "html",
        "url": "/trending/{{ scope.params.language | url_path }}",
        "items": "main .Box div[data-hpc] > article",
        "fields": {
          "title": {
            "select": ">h2 a",
            "transform": "normalize_whitespace"
          },
          "url": {
            "select": ">h2 a",
            "attr": "href"
          },
          "stats": {
            "stars": {
              "select": "[href$=stargazers]",
              "transform": {
                "op": "replace",
                "search": ",",
                "replacement": ""
              }
            }
          },
          "content": {
            "text": ">p"
          }
        },
        "query": {
          "since": "{{ scope.params.dateRange }}",
          "spoken_language_code": "{{ scope.params.spokenLanguage }}"
        }
      }
    },
    "issues": {
      "metadata": {
        "title": "Issues"
      },
      "params": {
        "owner": {
          "type": "text",
          "title": "Owner",
          "default": "microsoft",
          "required": true,
          "validate": {
            "regex": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          }
        },
        "repo": {
          "type": "text",
          "title": "Repository",
          "default": "vscode",
          "required": true,
          "validate": {
            "regex": "^[A-Za-z0-9_.-]+$"
          }
        },
        "query": {
          "type": "text",
          "title": "Search query",
          "description": "GitHub search filters, such as is:open label:bug sort:updated-desc.",
          "default": "is:issue is:open sort:updated-desc"
        }
      },
      "radar": [
        {
          "id": "github-issues",
          "match": {
            "hosts": [
              "github.com"
            ],
            "paths": [
              "/:owner/:repo/issues"
            ]
          },
          "patch": {
            "params": {
              "owner": "{{ scope.path.owner }}",
              "repo": "{{ scope.path.repo }}",
              "query": "{{ scope.query.q ?? \"is:issue is:open\" }}"
            },
            "metadata": {
              "title": "{{ scope.params.owner }}/{{ scope.params.repo }} | Issues"
            }
          }
        }
      ],
      "loader": {
        "type": "json",
        "url": "/{{ scope.params.owner }}/{{ scope.params.repo }}/issues",
        "items": "payload.issuesIndexContentRoute.results[].issue",
        "metadata": {
          "title": {
            "template": "{{ scope.params.owner }}/{{ scope.params.repo }} | Issues"
          },
          "home": {
            "template": "{{ scope.request.url }}"
          }
        },
        "fields": {
          "title": "title",
          "url": "permalink",
          "publishedAt": {
            "select": "createdAt",
            "transform": "date_to_ms"
          },
          "author": {
            "name": "author.login",
            "home": "author.resourcePath"
          },
          "stats": {
            "comments": "commentCount"
          },
          "attributes": {
            "state": {
              "select": "state",
              "transform": [
                {
                  "op": "replace",
                  "search": "REPO_ISSUE_STATE_",
                  "replacement": ""
                },
                "lowercase"
              ]
            },
            "stateReason": "stateReason"
          },
          "icon": {
            "src": "author.avatarUrl",
            "kind": {
              "template": "author"
            },
            "label": "author.login"
          }
        },
        "embeddedJson": {
          "select": "script[data-target=\"react-app.embeddedData\"]"
        },
        "query": {
          "q": "{{ scope.params.query }}"
        }
      },
      "version": 6
    },
    "pulls": {
      "metadata": {
        "title": "Pull requests"
      },
      "params": {
        "owner": {
          "type": "text",
          "title": "Owner",
          "default": "microsoft",
          "required": true,
          "validate": {
            "regex": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          }
        },
        "repo": {
          "type": "text",
          "title": "Repository",
          "default": "vscode",
          "required": true,
          "validate": {
            "regex": "^[A-Za-z0-9_.-]+$"
          }
        },
        "query": {
          "type": "text",
          "title": "Search query",
          "description": "GitHub search filters, such as is:open label:bug sort:updated-desc.",
          "default": "is:pr is:open sort:updated-desc"
        }
      },
      "radar": [
        {
          "id": "github-pulls",
          "match": {
            "hosts": [
              "github.com"
            ],
            "paths": [
              "/:owner/:repo/pulls"
            ]
          },
          "patch": {
            "params": {
              "owner": "{{ scope.path.owner }}",
              "repo": "{{ scope.path.repo }}",
              "query": "{{ scope.query.q ?? \"is:pr is:open\" }}"
            },
            "metadata": {
              "title": "{{ scope.params.owner }}/{{ scope.params.repo }} | Pull requests"
            }
          }
        }
      ],
      "loader": {
        "type": "json",
        "url": "/{{ scope.params.owner }}/{{ scope.params.repo }}/pulls",
        "items": "payload.repoPullsDashboardContentRoute.results",
        "metadata": {
          "title": {
            "template": "{{ scope.params.owner }}/{{ scope.params.repo }} | Pull requests"
          },
          "home": {
            "template": "{{ scope.request.url }}"
          }
        },
        "fields": {
          "title": "title",
          "url": "permalink",
          "publishedAt": {
            "select": "createdAt",
            "transform": "date_to_ms"
          },
          "author": {
            "name": "author.displayName || author.displayLogin"
          },
          "stats": {
            "comments": "commentCount"
          },
          "attributes": {
            "state": {
              "select": "displayState",
              "transform": [
                {
                  "op": "replace",
                  "search": "REPO_PULL_REQUEST_DISPLAY_STATE_",
                  "replacement": ""
                },
                "lowercase"
              ]
            }
          },
          "icon": {
            "src": "author.avatarUrl || ([author][?displayLogin].join('', ['https://avatars.githubusercontent.com/', displayLogin, '?s=64']) | [0])",
            "kind": {
              "template": "author"
            },
            "label": "author.displayName || author.displayLogin"
          }
        },
        "embeddedJson": {
          "select": "script[data-target=\"react-app.embeddedData\"]"
        },
        "query": {
          "q": "{{ scope.params.query }}"
        }
      },
      "version": 8
    },
    "issue-comments": {
      "metadata": {
        "title": "Issue comments",
        "desc": "Comments included in the page HTML. GitHub may collapse older comments and review threads."
      },
      "params": {
        "owner": {
          "type": "text",
          "title": "Owner",
          "default": "microsoft",
          "required": true,
          "validate": {
            "regex": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          }
        },
        "repo": {
          "type": "text",
          "title": "Repository",
          "default": "vscode",
          "required": true,
          "validate": {
            "regex": "^[A-Za-z0-9_.-]+$"
          }
        },
        "number": {
          "type": "text",
          "title": "Number",
          "default": "1",
          "required": true,
          "validate": {
            "regex": "^[1-9][0-9]*$"
          }
        }
      },
      "radar": [
        {
          "id": "github-issue-comments",
          "match": {
            "hosts": [
              "github.com"
            ],
            "paths": [
              "/:owner/:repo/issues/:number"
            ]
          },
          "patch": {
            "params": {
              "owner": "{{ scope.path.owner }}",
              "repo": "{{ scope.path.repo }}",
              "number": "{{ scope.path.number }}"
            },
            "metadata": {
              "title": "{{ scope.params.owner }}/{{ scope.params.repo }} #{{ scope.params.number }} | Issue comments"
            }
          }
        }
      ],
      "loader": {
        "type": "json",
        "url": "/{{ scope.params.owner }}/{{ scope.params.repo }}/issues/{{ scope.params.number }}",
        "items": "payload.issueViewerRoute.data.repository.issue.timelineItems.edges[].node | [?__typename == `\"IssueComment\"`]",
        "metadata": {
          "title": {
            "template": "{{ scope.params.owner }}/{{ scope.params.repo }} #{{ scope.params.number }} | Issue comments"
          },
          "home": {
            "template": "{{ scope.request.url }}"
          }
        },
        "fields": {
          "title": {
            "select": "body",
            "template": "{{ scope.value || scope.item.author.login || 'Comment' }}",
            "transform": [
              "normalize_whitespace",
              {
                "op": "truncate",
                "length": 160,
                "suffix": "…"
              }
            ]
          },
          "url": "url",
          "publishedAt": {
            "select": "createdAt",
            "transform": "date_to_ms"
          },
          "author": {
            "name": "author.login",
            "home": "author.profileUrl"
          },
          "content": {
            "markdown": "body"
          },
          "icon": {
            "src": "author.avatarUrl",
            "kind": {
              "template": "author"
            },
            "label": "author.login"
          }
        },
        "embeddedJson": {
          "select": "script[data-target=\"react-app.embeddedData\"]"
        }
      },
      "version": 6
    },
    "pull-comments": {
      "metadata": {
        "title": "Pull request comments",
        "desc": "Comments included in the page HTML. GitHub may collapse older comments and review threads."
      },
      "params": {
        "owner": {
          "type": "text",
          "title": "Owner",
          "default": "microsoft",
          "required": true,
          "validate": {
            "regex": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          }
        },
        "repo": {
          "type": "text",
          "title": "Repository",
          "default": "vscode",
          "required": true,
          "validate": {
            "regex": "^[A-Za-z0-9_.-]+$"
          }
        },
        "number": {
          "type": "text",
          "title": "Number",
          "default": "340709",
          "required": true,
          "validate": {
            "regex": "^[1-9][0-9]*$"
          }
        }
      },
      "radar": [
        {
          "id": "github-pull-comments",
          "match": {
            "hosts": [
              "github.com"
            ],
            "paths": [
              "/:owner/:repo/pull/:number"
            ]
          },
          "patch": {
            "params": {
              "owner": "{{ scope.path.owner }}",
              "repo": "{{ scope.path.repo }}",
              "number": "{{ scope.path.number }}"
            },
            "metadata": {
              "title": "{{ scope.params.owner }}/{{ scope.params.repo }} #{{ scope.params.number }} | Pull request comments"
            }
          }
        }
      ],
      "loader": {
        "type": "html",
        "url": "/{{ scope.params.owner }}/{{ scope.params.repo }}/pull/{{ scope.params.number }}",
        "items": ".timeline-comment-group[id^=\"issuecomment-\"], .timeline-comment[id^=\"pullrequestreview-\"], .review-comment[id^=\"discussion_r\"]",
        "metadata": {
          "title": {
            "template": "{{ scope.params.owner }}/{{ scope.params.repo }} #{{ scope.params.number }} | Pull request comments"
          },
          "home": {
            "template": "{{ scope.request.url }}"
          }
        },
        "fields": {
          "title": {
            "select": ".comment-body",
            "template": "{{ scope.value || scope.item.author.name || 'Comment' }}",
            "transform": [
              "normalize_whitespace",
              {
                "op": "truncate",
                "length": 160,
                "suffix": "…"
              }
            ]
          },
          "url": {
            "select": "",
            "attr": "id",
            "template": "{{ scope.request.url }}#{{ scope.value }}"
          },
          "publishedAt": {
            "select": "relative-time[datetime]",
            "attr": "datetime",
            "traverse": {
              "type": "closest",
              "selector": ".js-comment-container, .js-timeline-item, .review-comment"
            },
            "transform": "date_to_ms"
          },
          "author": {
            "name": ".author",
            "home": {
              "select": ".author",
              "attr": "href"
            }
          },
          "content": {
            "html": {
              "select": ".comment-body",
              "content": "html"
            }
          },
          "icon": {
            "src": {
              "traverse": {
                "type": "closest",
                "selector": ".js-comment-container, .js-timeline-item, .review-comment"
              },
              "select": "img.avatar",
              "attr": "src"
            },
            "kind": {
              "template": "author"
            },
            "label": ".author"
          }
        }
      },
      "version": 4
    },
    "releases": {
      "metadata": {
        "title": "Releases"
      },
      "params": {
        "owner": {
          "type": "text",
          "title": "Owner",
          "default": "openclaw",
          "required": true,
          "validate": {
            "regex": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          }
        },
        "repo": {
          "type": "text",
          "title": "Repository",
          "default": "openclaw",
          "required": true,
          "validate": {
            "regex": "^[A-Za-z0-9_.-]+$"
          }
        },
        "query": {
          "type": "text",
          "title": "Search query",
          "description": "Find releases by version or title.",
          "default": ""
        },
        "page": {
          "type": "number",
          "title": "Page",
          "default": 1,
          "min": 1
        }
      },
      "radar": [
        {
          "id": "github-releases",
          "match": {
            "hosts": [
              "github.com"
            ],
            "paths": [
              "/:owner/:repo/releases"
            ]
          },
          "patch": {
            "params": {
              "owner": "{{ scope.path.owner }}",
              "repo": "{{ scope.path.repo }}",
              "query": "{{ scope.query.q }}",
              "page": "{{ scope.query.page ?? 1 }}"
            },
            "metadata": {
              "title": "{{ scope.params.owner }}/{{ scope.params.repo }} | Releases"
            }
          }
        }
      ],
      "loader": {
        "type": "html",
        "url": "/{{ scope.params.owner }}/{{ scope.params.repo }}/releases",
        "items": "section[data-release-anchor]",
        "metadata": {
          "title": {
            "template": "{{ scope.params.owner }}/{{ scope.params.repo }} | Releases"
          },
          "home": {
            "template": "{{ scope.request.url }}"
          }
        },
        "fields": {
          "title": {
            "select": "a.Link--primary[href*=\"/releases/tag/\"]",
            "transform": "normalize_whitespace"
          },
          "url": {
            "select": "a.Link--primary[href*=\"/releases/tag/\"]",
            "attr": "href"
          },
          "publishedAt": {
            "select": "relative-time[datetime][prefix]",
            "attr": "datetime",
            "transform": "date_to_ms"
          },
          "author": {
            "name": "div:has(> relative-time[datetime][prefix]) > a",
            "home": {
              "select": "div:has(> relative-time[datetime][prefix]) > a",
              "attr": "href"
            }
          },
          "attributes": {
            "tag": {
              "select": "",
              "attr": "data-release-anchor",
              "transform": {
                "op": "regex_replace",
                "pattern": "^release-",
                "replacement": ""
              }
            }
          },
          "content": {
            "html": {
              "select": ".markdown-body",
              "content": "html"
            }
          },
          "icon": {
            "src": {
              "select": "div:has(> relative-time[datetime][prefix]) > img",
              "attr": "src"
            },
            "kind": {
              "template": "author"
            },
            "label": "div:has(> relative-time[datetime][prefix]) > a"
          }
        },
        "query": {
          "page": "{{ scope.params.page }}",
          "q": "{{ scope.params.query }}"
        }
      },
      "version": 3
    },
    "commits": {
      "metadata": {
        "title": "Commits"
      },
      "params": {
        "owner": {
          "type": "text",
          "title": "Owner",
          "default": "openclaw",
          "required": true,
          "validate": {
            "regex": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          }
        },
        "repo": {
          "type": "text",
          "title": "Repository",
          "default": "openclaw",
          "required": true,
          "validate": {
            "regex": "^[A-Za-z0-9_.-]+$"
          }
        },
        "ref": {
          "type": "text",
          "title": "Ref",
          "description": "Branch, tag, or commit SHA, such as main or v1.0.0.",
          "default": "main",
          "required": true
        },
        "author": {
          "type": "text",
          "title": "Author",
          "description": "Filter by GitHub login or commit author email.",
          "default": ""
        },
        "since": {
          "type": "text",
          "title": "Since",
          "description": "Start of the date range, such as 2026-01-01.",
          "default": ""
        },
        "until": {
          "type": "text",
          "title": "Until",
          "description": "End of the date range, such as 2026-12-31.",
          "default": ""
        },
        "after": {
          "type": "text",
          "title": "After cursor",
          "description": "GitHub pagination cursor from the page URL; leave empty for the latest commits.",
          "default": ""
        }
      },
      "radar": [
        {
          "id": "github-commits",
          "match": {
            "hosts": [
              "github.com"
            ],
            "paths": [
              "/:owner/:repo/commits/:ref"
            ]
          },
          "patch": {
            "params": {
              "owner": "{{ scope.path.owner }}",
              "repo": "{{ scope.path.repo }}",
              "ref": "{{ scope.path.ref }}",
              "author": "{{ scope.query.author }}",
              "since": "{{ scope.query.since }}",
              "until": "{{ scope.query.until }}",
              "after": "{{ scope.query.after }}"
            },
            "metadata": {
              "title": "{{ scope.params.owner }}/{{ scope.params.repo }} | Commits {{ scope.params.ref }}"
            }
          }
        }
      ],
      "loader": {
        "type": "json",
        "url": "/{{ scope.params.owner }}/{{ scope.params.repo }}/commits/{{ scope.params.ref | url_path }}/",
        "embeddedJson": {
          "select": "script[data-target=\"react-app.embeddedData\"]"
        },
        "items": "payload.commitsRefRoute.commitGroups[].commits[]",
        "metadata": {
          "title": {
            "template": "{{ scope.params.owner }}/{{ scope.params.repo }} | Commits {{ scope.params.ref }}"
          },
          "home": {
            "template": "{{ scope.request.url }}"
          }
        },
        "fields": {
          "title": "shortMessage",
          "url": "url",
          "publishedAt": {
            "select": "committedDate",
            "transform": "date_to_ms"
          },
          "author": {
            "name": "authors[0].login || authors[0].displayName",
            "home": "authors[0].path"
          },
          "attributes": {
            "sha": {
              "select": "oid",
              "transform": {
                "op": "truncate",
                "length": 7,
                "suffix": ""
              }
            }
          },
          "content": {
            "html": "bodyMessageHtml"
          },
          "icon": {
            "src": "authors[0].avatarUrl",
            "kind": {
              "template": "author"
            },
            "label": "authors[0].login || authors[0].displayName"
          }
        },
        "query": {
          "author": "{{ scope.params.author }}",
          "since": "{{ scope.params.since }}",
          "until": "{{ scope.params.until }}",
          "after": "{{ scope.params.after }}"
        }
      },
      "version": 4
    }
  }
}
