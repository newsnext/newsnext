{
  "title": "早晨报",
  "category": "news",
  "color": "red",
  "defaults": {
    "baseUrl": "https://www.zaochenbao.com/",
    "metadata": {
      "home": "/"
    }
  },
  "sources": {
    "realtime": {
      "metadata": {
        "title": "即时新闻",
        "home": "/realtime/"
      },
      "loader": {
        "type": "html",
        "url": "/realtime/",
        "decoding": "gb2312",
        "items": "div.list-block > a.item",
        "fields": {
          "title": ".eps",
          "url": {
            "attr": "href"
          },
          "publishedAt": {
            "select": ".pdt10",
            "transform": [
              {
                "op": "replace",
                "search": "- ",
                "replacement": "T"
              },
              {
                "op": "append",
                "value": "+08:00"
              },
              "date_to_ms"
            ]
          }
        },
        "sortByTimestamp": true
      }
    }
  }
}
