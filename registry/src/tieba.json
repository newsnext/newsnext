{
  "title": "百度贴吧",
  "category": "forum",
  "color": "blue",
  "defaults": {
    "baseUrl": "https://tieba.baidu.com/",
    "metadata": {
      "home": "/"
    }
  },
  "sources": {
    "hot-topic": {
      "version": 3,
      "metadata": {
        "title": "热议",
        "type": "ranking"
      },
      "loader": {
        "type": "json",
        "url": "/hottopic/browse/topicList",
        "items": "data.bang_topic.topic_list",
        "fields": {
          "title": "topic_name",
          "url": {
            "select": "topic_url",
            "transform": {
              "op": "replace",
              "search": "&amp;",
              "replacement": "&"
            }
          },
          "publishedAt": {
            "select": "create_time",
            "transform": "seconds_to_ms"
          }
        }
      }
    }
  }
}
