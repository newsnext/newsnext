{
  "title": "RSS",
  "category": "news",
  "color": "orange",
  "icon": "https://s3.newsnext.app/icons/rss.png",
  "defaults": {
    "metadata": {
      "title": "RSS Feed"
    }
  },
  "sources": {
    "feed": {
      "params": {
        "url": {
          "type": "url",
          "title": "Feed URL",
          "description": "The HTTP or HTTPS URL of an RSS, Atom, or JSON Feed.",
          "default": "https://sspai.com/feed"
        }
      },
      "loader": {
        "type": "rss",
        "url": "{{ scope.params.url }}"
      },
      "capabilities": {
        "network": [
          "*"
        ]
      }
    }
  }
}
