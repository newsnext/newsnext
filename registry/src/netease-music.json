{
  "title": "网易云音乐",
  "category": "entertainment",
  "color": "red",
  "defaults": {
    "baseUrl": "https://music.163.com/",
    "version": 4,
    "metadata": {
      "home": "/"
    },
    "loader": {
      "type": "json",
      "url": "/api/playlist/detail",
      "items": "(result.tracks || playlist.tracks)[:100]",
      "metadata": {
        "badge": "result.coverImgUrl",
        "desc": "result.description",
        "title": "result.name"
      },
      "fields": {
        "title": "name",
        "url": {
          "select": "id",
          "template": "/song?id={{ scope.value | url_query }}"
        },
        "attributes": {
          "artists": "[join(' / ', (ar || artists || `[]`)[].name), al.name || album.name] | [?@ != `null` && @ != ''] | join(' · ', @)"
        },
        "icon": {
          "src": "al.picUrl || album.picUrl",
          "kind": {
            "template": "cover"
          },
          "label": "al.name || album.name"
        },
        "content": {
          "pictures": "al.picUrl || album.picUrl"
        }
      },
      "annotation": "{{ scope.item.attributes.artists }}",
      "query": {
        "id": "{{ scope.params.id }}"
      }
    }
  },
  "sources": {
    "playlist": {
      "metadata": {
        "title": "歌单"
      },
      "params": {
        "id": {
          "type": "text",
          "default": "17990594711",
          "title": "歌单 ID",
          "validate": {
            "format": "digits"
          }
        }
      },
      "radar": [
        {
          "id": "netease-music-playlist",
          "match": {
            "hosts": [
              "music.163.com",
              "y.music.163.com"
            ],
            "location": "hash",
            "paths": [
              "/playlist"
            ],
            "query": [
              "id"
            ]
          },
          "patch": {
            "params": {
              "id": "{{ scope.query.id }}"
            },
            "metadata": {
              "title": {
                "select": "title",
                "transform": {
                  "op": "regex_extract",
                  "pattern": "^(.+?)\\s*-\\s*歌单\\s*-\\s*网易云音乐$",
                  "group": 1
                },
                "template": "{{ scope.value | default: '歌单' }}"
              }
            }
          }
        }
      ],
      "loader": {
        "metadata": {
          "home": {
            "template": "/#/playlist?id={{ scope.params.id | url_query }}"
          }
        }
      }
    },
    "ranking": {
      "version": 4,
      "metadata": {
        "title": "排行榜",
        "type": "ranking"
      },
      "params": {
        "id": {
          "type": "text",
          "default": "19723756",
          "title": "排行榜 ID",
          "validate": {
            "format": "digits"
          }
        }
      },
      "radar": [
        {
          "id": "netease-music-ranking",
          "match": {
            "hosts": [
              "music.163.com",
              "y.music.163.com"
            ],
            "location": "hash",
            "paths": [
              "/discover/toplist"
            ],
            "query": [
              "id"
            ]
          },
          "patch": {
            "params": {
              "id": "{{ scope.query.id }}"
            },
            "metadata": {
              "title": {
                "select": "title",
                "transform": {
                  "op": "regex_extract",
                  "pattern": "^(.+?)\\s*-\\s*排行榜\\s*-\\s*网易云音乐$",
                  "group": 1
                },
                "template": "{{ scope.value | default: '排行榜' }}"
              }
            }
          }
        }
      ],
      "loader": {
        "metadata": {
          "home": {
            "template": "/#/discover/toplist?id={{ scope.params.id | url_query }}"
          }
        }
      }
    }
  }
}
