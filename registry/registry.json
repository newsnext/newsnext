{
  "36kr:hot-list": {
    "baseUrl": "https://36kr.com/",
    "vars": {
      "gateway": "https://gateway.36kr.com",
      "newsflashCategories": {
        "0": "全部",
        "1": "热点",
        "2": "股市",
        "3": "公司",
        "4": "宏观"
      }
    },
    "metadata": {
      "home": "/hot-list/catalog",
      "title": "人气榜",
      "type": "ranking"
    },
    "version": 3,
    "radar": [
      {
        "id": "36kr-hot-list",
        "match": {
          "hosts": [
            "36kr.com"
          ],
          "paths": [
            "/hot-list/*rest"
          ]
        }
      }
    ],
    "loader": {
      "type": "json",
      "url": "{{ source.vars.gateway }}/api/mis/x/rank/list",
      "fetchOptions": {
        "method": "POST",
        "json": {
          "partner_id": "web",
          "param": {
            "siteId": 1,
            "platformId": 2
          }
        }
      },
      "items": "data.topList",
      "fields": {
        "title": "widgetTitle",
        "url": {
          "select": "itemId",
          "template": "/p/{{ scope.value }}"
        },
        "publishedAt": "publishTime",
        "author": {
          "name": "authorName"
        },
        "attributes": {
          "heat": "statHot"
        },
        "content": {
          "text": "summary",
          "pictures": "widgetImage"
        }
      },
      "itemTemplate": {
        "inline": "{{ scope.item.attributes.heat }}w heat · {{ scope.item.author.name }}"
      }
    },
    "provider": {
      "title": "36氪",
      "category": "news",
      "icon": "https://36kr.com/favicon.ico",
      "color": "blue"
    }
  },
  "36kr:information": {
    "baseUrl": "https://36kr.com/",
    "vars": {
      "gateway": "https://gateway.36kr.com",
      "newsflashCategories": {
        "0": "全部",
        "1": "热点",
        "2": "股市",
        "3": "公司",
        "4": "宏观"
      }
    },
    "metadata": {
      "home": "/",
      "title": "资讯"
    },
    "params": {
      "channel": {
        "type": "select",
        "title": "栏目",
        "values": [
          {
            "label": "最新",
            "value": "web_news"
          },
          {
            "label": "推荐",
            "value": "web_recommend"
          },
          {
            "label": "创投",
            "value": "contact"
          },
          {
            "label": "财经",
            "value": "ccs"
          },
          {
            "label": "汽车",
            "value": "travel"
          },
          {
            "label": "AI",
            "value": "AI"
          },
          {
            "label": "科技",
            "value": "technology"
          },
          {
            "label": "专精特新",
            "value": "shuzihua"
          },
          {
            "label": "创新",
            "value": "innovate"
          },
          {
            "label": "企服",
            "value": "enterpriseservice"
          },
          {
            "label": "消费",
            "value": "happy_life"
          },
          {
            "label": "城市",
            "value": "real_estate"
          },
          {
            "label": "职场",
            "value": "web_zhichang"
          }
        ],
        "default": "web_news"
      }
    },
    "radar": [
      {
        "id": "36kr-information",
        "match": {
          "hosts": [
            "36kr.com"
          ],
          "paths": [
            "/information/:channel",
            "/information/:channel/*rest"
          ]
        },
        "patch": {
          "params": {
            "channel": "{{ scope.path.channel }}"
          }
        }
      }
    ],
    "loader": {
      "type": "json",
      "url": "{{ source.vars.gateway }}/api/mis/nav/ifm/subNav/flow",
      "fetchOptions": {
        "method": "POST",
        "json": {
          "partner_id": "web",
          "param": {
            "subnavType": 1,
            "subnavNick": "{{ scope.params.channel }}",
            "pageSize": 30,
            "pageEvent": 0,
            "siteId": 1,
            "platformId": 2
          }
        }
      },
      "items": "data.itemList[?itemType == `10`]",
      "fields": {
        "title": "templateMaterial.widgetTitle",
        "url": {
          "select": "itemId",
          "template": "/p/{{ scope.value }}"
        },
        "publishedAt": "templateMaterial.publishTime",
        "author": {
          "name": "templateMaterial.authorName"
        },
        "content": {
          "text": "templateMaterial.summary",
          "pictures": "templateMaterial.widgetImage"
        }
      }
    },
    "provider": {
      "title": "36氪",
      "category": "news",
      "icon": "https://36kr.com/favicon.ico",
      "color": "blue"
    }
  },
  "36kr:newsflashes": {
    "baseUrl": "https://36kr.com/",
    "vars": {
      "gateway": "https://gateway.36kr.com",
      "newsflashCategories": {
        "0": "全部",
        "1": "热点",
        "2": "股市",
        "3": "公司",
        "4": "宏观"
      }
    },
    "metadata": {
      "home": "/",
      "title": "快讯"
    },
    "params": {
      "category": {
        "type": "select",
        "title": "分类",
        "values": [
          {
            "label": "全部",
            "value": "0"
          },
          {
            "label": "热点",
            "value": "1"
          },
          {
            "label": "股市",
            "value": "2"
          },
          {
            "label": "公司",
            "value": "3"
          },
          {
            "label": "宏观",
            "value": "4"
          }
        ],
        "default": "0"
      }
    },
    "radar": [
      {
        "id": "36kr-newsflashes",
        "match": {
          "hosts": [
            "36kr.com"
          ],
          "paths": [
            "/newsflashes",
            "/newsflashes/:id",
            "/newsflashes/catalog/:type"
          ]
        },
        "patch": {
          "params": {
            "category": "{{ scope.path.type }}"
          },
          "metadata": {
            "title": "快讯 | {{ source.vars.newsflashCategories[scope.params.category] | default: '全部' }}"
          }
        }
      }
    ],
    "loader": {
      "type": "json",
      "url": "{{ source.vars.gateway }}/api/mis/nav/newsflash/flow",
      "fetchOptions": {
        "method": "POST",
        "json": {
          "partner_id": "web",
          "param": {
            "siteId": 1,
            "platformId": 2,
            "pageSize": 20,
            "pageEvent": 0,
            "type": "{{ scope.params.category }}"
          }
        }
      },
      "items": "data.itemList[?itemType == `20`]",
      "fields": {
        "title": "templateMaterial.widgetTitle",
        "url": {
          "select": "itemId",
          "template": "/newsflashes/{{ scope.value }}"
        },
        "publishedAt": "templateMaterial.publishTime",
        "content": {
          "text": "templateMaterial.widgetContent"
        }
      }
    },
    "provider": {
      "title": "36氪",
      "category": "news",
      "icon": "https://36kr.com/favicon.ico",
      "color": "blue"
    }
  },
  "aihot:all": {
    "baseUrl": "https://aihot.virxact.com/",
    "metadata": {
      "home": "/"
    },
    "loader": {
      "type": "json",
      "url": "/api/public/items?mode=all&take=30",
      "items": "items[?id && title && url]",
      "fields": {
        "title": "title",
        "url": "url",
        "publishedAt": {
          "select": "publishedAt",
          "template": "{{ scope.value | date_to_ms }}"
        },
        "attributes": {
          "source": "source",
          "category": "category"
        },
        "content": {
          "text": "summary"
        }
      },
      "itemTemplate": {
        "inline": "{{ scope.item.attributes.source }}{% if scope.item.attributes.category %} · {{ scope.item.attributes.category }}{% endif %}"
      }
    },
    "provider": {
      "title": "AIHot",
      "category": "news",
      "color": "blue"
    }
  },
  "github:trending": {
    "baseUrl": "https://github.com/",
    "metadata": {
      "home": "/trending",
      "title": "Trending",
      "type": "ranking"
    },
    "version": 3,
    "params": {
      "language": {
        "type": "text",
        "title": "Language",
        "description": "Programming language slug used by GitHub Trending, such as javascript, go, or rust.",
        "default": ""
      },
      "spokenLanguage": {
        "type": "text",
        "title": "Spoken Language",
        "description": "Repository description language code, such as en, zh, or ja.",
        "default": ""
      },
      "dateRange": {
        "type": "select",
        "title": "Date range",
        "values": [
          {
            "label": "Today",
            "value": "daily"
          },
          {
            "label": "This week",
            "value": "weekly"
          },
          {
            "label": "This month",
            "value": "monthly"
          }
        ],
        "default": "daily"
      }
    },
    "radar": [
      {
        "id": "github-trending",
        "match": {
          "hosts": [
            "github.com"
          ],
          "paths": [
            "/trending",
            "/trending/:language"
          ]
        },
        "patch": {
          "params": {
            "language": "{{ scope.path.language }}",
            "spokenLanguage": "{{ scope.query.spoken_language_code }}",
            "dateRange": "{{ scope.query.since }}"
          },
          "metadata": {
            "title": "Trending {{ scope.params.language }}"
          }
        }
      }
    ],
    "loader": {
      "type": "html",
      "url": "/trending{% if scope.params.language %}/{{ scope.params.language | url_path }}{% endif %}?since={{ scope.params.dateRange | url_query }}{% if scope.params.spokenLanguage %}&spoken_language_code={{ scope.params.spokenLanguage | url_query }}{% endif %}",
      "items": "main .Box div[data-hpc] > article",
      "fields": {
        "title": {
          "select": ">h2 a",
          "template": "{{ scope.value | normalize_whitespace }}"
        },
        "url": {
          "select": ">h2 a",
          "attr": "href"
        },
        "stats": {
          "stars": {
            "select": "[href$=stargazers]",
            "template": "{{ scope.value | replace: ',', '' }}"
          }
        },
        "content": {
          "text": ">p"
        }
      }
    },
    "provider": {
      "title": "GitHub",
      "category": "developer",
      "color": "slate"
    }
  },
  "hackernews:ask": {
    "baseUrl": "https://news.ycombinator.com/",
    "loader": {
      "type": "html",
      "url": "/ask",
      "items": ".athing",
      "fields": {
        "title": ".titleline>a",
        "url": {
          "select": "",
          "attr": "id",
          "template": "/item?id={{ scope.value | url_query }}"
        },
        "publishedAt": {
          "traverse": {
            "type": "next",
            "selector": "tr"
          },
          "select": ".age",
          "attr": "title",
          "template": "{{ scope.value | split: ' ' | last | times: 1000 }}"
        },
        "author": {
          "name": {
            "traverse": {
              "type": "next",
              "selector": "tr"
            },
            "select": ".hnuser"
          },
          "home": {
            "traverse": {
              "type": "next",
              "selector": "tr"
            },
            "select": ".hnuser",
            "attr": "href"
          }
        },
        "stats": {
          "score": {
            "traverse": {
              "type": "next",
              "selector": "tr"
            },
            "select": ".score",
            "template": "{{ scope.value | regex_extract: '([0-9]+)', 1 }}"
          },
          "comments": {
            "traverse": {
              "type": "next",
              "selector": "tr"
            },
            "select": ".subline > a:last-child",
            "template": "{{ scope.value | regex_extract: '([0-9]+)', 1 | default: 0 }}"
          }
        },
        "attributes": {
          "rank": {
            "select": ".rank",
            "template": "{{ scope.value | regex_extract: '([0-9]+)', 1 }}"
          },
          "site": ".sitestr",
          "externalUrl": {
            "select": ".titleline>a",
            "attr": "href",
            "template": "{{ scope.value | absolute_url: scope.request.url }}"
          }
        },
        "icon": {
          "src": {
            "select": ".titleline>a",
            "attr": "href",
            "template": "{{ scope.value | absolute_url: scope.request.url | favicon_url }}"
          },
          "kind": {
            "template": "site"
          },
          "label": ".sitestr"
        }
      },
      "itemTemplate": {
        "inline": "{{ scope.item.author.name }}"
      }
    },
    "metadata": {
      "home": "/ask",
      "title": "Ask",
      "type": "ranking"
    },
    "version": 3,
    "provider": {
      "title": "Hacker News",
      "category": "forum",
      "color": "orange"
    }
  },
