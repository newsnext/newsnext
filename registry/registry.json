  "netease-music:playlist": {
    "baseUrl": "https://music.163.com/",
    "version": 3,
    "metadata": {
      "home": "/",
      "title": "歌单"
    },
    "loader": {
      "type": "json",
      "url": "/api/playlist/detail?id={{ scope.params.id | url_query }}",
      "items": "(result.tracks || playlist.tracks)[:100]",
      "metadata": {
        "badge": "result.coverImgUrl",
        "desc": "result.description",
        "title": "result.name",
        "home": {
          "template": "/#/playlist?id={{ scope.params.id | url_query }}"
        }
      },
      "fields": {
        "title": "name",
        "url": {
          "select": "id",
          "template": "/song?id={{ scope.value | url_query }}"
        },
        "attributes": {
          "artists": {
            "template": "{% assign artists = scope.item.ar | default: scope.item.artists %}{% for artist in artists %}{% unless forloop.first %} / {% endunless %}{{ artist.name }}{% endfor %}{% assign album = scope.item.al.name | default: scope.item.album.name %}{% if artists and album %} · {% endif %}{{ album | default: '' }}"
          }
        },
        "icon": {
          "src": "al.picUrl || album.picUrl",
          "kind": {
            "template": "cover"
          },
          "label": "al.name || album.name"
        },
        "content": {
          "pictures": "al.picUrl || album.picUrl"
        }
      },
      "itemTemplate": {
        "inline": "{{ scope.item.attributes.artists }}"
      }
    },
    "params": {
      "id": {
        "type": "text",
        "default": "17990594711",
        "title": "歌单 ID",
        "validate": {
          "format": "digits"
        }
      }
    },
    "radar": [
      {
        "id": "netease-music-playlist",
        "match": {
          "hosts": [
            "music.163.com",
            "y.music.163.com"
          ],
          "location": "hash",
          "paths": [
            "/playlist"
          ],
          "query": [
            "id"
          ]
        },
        "patch": {
          "params": {
            "id": "{{ scope.query.id }}"
          },
          "metadata": {
            "title": "{% assign title = scope.page.title | regex_extract: '^(.+?)\\\\s*-\\\\s*歌单\\\\s*-\\\\s*网易云音乐$', 1 %}{% if title != empty %}{{ title }}{% else %}歌单 {{ scope.params.id }}{% endif %}"
          }
        }
      }
    ],
    "provider": {
      "title": "网易云音乐",
      "category": "entertainment",
      "color": "red"
    }
  },
  "netease-music:ranking": {
    "baseUrl": "https://music.163.com/",
    "version": 4,
    "metadata": {
      "home": "/",
      "title": "排行榜",
      "type": "ranking"
    },
    "loader": {
      "type": "json",
      "url": "/api/playlist/detail?id={{ scope.params.id | url_query }}",
      "items": "(result.tracks || playlist.tracks)[:100]",
      "metadata": {
        "badge": "result.coverImgUrl",
        "desc": "result.description",
        "title": "result.name",
        "home": {
          "template": "/#/discover/toplist?id={{ scope.params.id | url_query }}"
        }
      },
      "fields": {
        "title": "name",
        "url": {
          "select": "id",
          "template": "/song?id={{ scope.value | url_query }}"
        },
        "attributes": {
          "artists": {
            "template": "{% assign artists = scope.item.ar | default: scope.item.artists %}{% for artist in artists %}{% unless forloop.first %} / {% endunless %}{{ artist.name }}{% endfor %}{% assign album = scope.item.al.name | default: scope.item.album.name %}{% if artists and album %} · {% endif %}{{ album | default: '' }}"
          }
        },
        "icon": {
          "src": "al.picUrl || album.picUrl",
          "kind": {
            "template": "cover"
          },
          "label": "al.name || album.name"
        },
        "content": {
          "pictures": "al.picUrl || album.picUrl"
        }
      },
      "itemTemplate": {
        "inline": "{{ scope.item.attributes.artists }}"
      }
    },
    "params": {
      "id": {
        "type": "text",
        "default": "19723756",
        "title": "排行榜 ID",
        "validate": {
          "format": "digits"
        }
      }
    },
    "radar": [
      {
        "id": "netease-music-ranking",
        "match": {
          "hosts": [
            "music.163.com",
            "y.music.163.com"
          ],
          "location": "hash",
          "paths": [
            "/discover/toplist"
          ],
          "query": [
            "id"
          ]
        },
        "patch": {
          "params": {
            "id": "{{ scope.query.id }}"
          },
          "metadata": {
            "title": "{% assign title = scope.page.title | regex_extract: '^(.+?)\\\\s*-\\\\s*排行榜\\\\s*-\\\\s*网易云音乐$', 1 %}{% if title != empty %}{{ title }}{% else %}排行榜 {{ scope.params.id }}{% endif %}"
          }
        }
      }
    ],
    "provider": {
      "title": "网易云音乐",
      "category": "entertainment",
      "color": "red"
    }
  },
  "newsnow:topic-latest": {
    "baseUrl": "https://www.newsnow.com/",
    "metadata": {
      "home": "/"
    },
    "params": {
      "locale": {
        "type": "select",
        "values": [
          {
            "label": "US",
            "value": "us"
          },
          {
            "label": "UK",
            "value": "uk"
          },
          {
            "label": "Nigeria",
            "value": "ng"
          },
          {
            "label": "România",
            "value": "ro"
          },
          {
            "label": "Italia",
            "value": "it"
          },
          {
            "label": "Canada",
            "value": "ca"
          },
          {
            "label": "Australia",
            "value": "au"
          }
        ],
        "default": "us",
        "title": "Locale"
      },
      "topic": {
        "type": "text",
        "default": "US",
        "title": "Topic"
      }
    },
    "radar": [
      {
        "id": "newsnow-topic",
        "match": {
          "hosts": [
            "newsnow.com"
          ],
          "paths": [
            "/:locale/*topic"
          ]
        },
        "patch": {
          "params": {
            "locale": "{{ scope.path.locale }}",
            "topic": "{{ scope.path.topic }}"
          },
          "metadata": {
            "title": "{{ scope.params.topic }}"
          }
        }
      }
    ],
    "loader": {
      "type": "html",
      "url": "/{{ scope.params.locale | url_path }}/{{ scope.params.topic | url_path }}?type=ln",
      "items": ".newsfeed .article",
      "fields": {
        "title": ".article-card__headline",
        "url": {
          "select": ".article-card__headline",
          "attr": "href"
        },
        "publishedAt": {
          "select": "[data-timestamp]",
          "attr": "data-timestamp",
          "template": "{{ scope.value | times: 1000 }}"
        },
        "attributes": {
          "publisher": ".article-publisher__name"
        }
      },
      "itemTemplate": {
        "inline": "{{ scope.item.attributes.publisher }}"
      }
    },
    "provider": {
      "title": "NEWS NOW",
      "category": "news",
      "color": "red"
    }
  },
  "rss:feed": {
    "version": 3,
    "metadata": {
      "title": "RSS Feed"
    },
    "params": {
      "url": {
        "type": "url",
        "title": "Feed URL",
        "description": "The HTTP or HTTPS URL of an RSS, Atom, or JSON Feed.",
        "default": "https://sspai.com/feed"
      }
    },
    "loader": {
      "type": "rss",
      "url": "{{ scope.params.url }}"
    },
    "capabilities": {
      "network": [
        "*"
      ]
    },
    "provider": {
      "title": "RSS",
      "category": "news",
      "icon": "https://s3.newsnext.app/icons/rss.png",
      "color": "orange"
    }
  },
  "telegram:channel": {
    "baseUrl": "https://t.me/",
    "metadata": {
      "home": "/",
      "title": "Channel"
    },
    "params": {
      "channel": {
        "type": "text",
        "default": "TestFlightCN",
        "title": "Channel"
      }
    },
    "radar": [
      {
        "id": "telegram-channel",
        "match": {
          "hosts": [
            "t.me",
            "telegram.me"
          ],
          "paths": [
            "/s/:channel",
            "/:channel"
          ]
        },
        "patch": {
          "params": {
            "channel": "{{ scope.path.channel }}"
          },
          "metadata": {
            "title": {
              "select": ".tgme_channel_info_header_title"
            },
            "badge": "/i/userpic/320/{{ scope.params.channel | url_path }}.jpg",
            "home": "/s/{{ scope.params.channel }}"
          }
        }
      }
    ],
    "loader": {
      "type": "html",
      "url": "/s/{{ scope.params.channel | url_path }}",
      "items": ".tgme_widget_message:has(.tgme_widget_message_text)",
      "fields": {
        "title": {
          "select": ".tgme_widget_message_text:not(.js-message_reply_text)",
          "brSeparator": "\n",
          "template": "{{ scope.value | first_line | truncate: 160, '…' }}"
        },
        "url": {
          "select": ".tgme_widget_message_date",
          "attr": "href"
        },
        "publishedAt": {
          "select": ".tgme_widget_message_date time",
          "attr": "datetime",
          "template": "{{ scope.value | date_to_ms }}"
        },
        "stats": {
          "views": {
            "select": ".tgme_widget_message_views",
            "template": "{{ scope.value | parse_compact_number }}"
          }
        },
        "content": {
          "text": {
            "select": [
              ".js-message_reply_text",
              ".tgme_widget_message_text:not(.js-message_reply_text)"
            ],
            "brSeparator": "\n",
            "template": "{{ scope.value | normalize_lines: 2 }}"
          },
          "pictures": {
            "select": ".tgme_widget_message_photo_wrap, .tgme_widget_message_video_thumb",
            "attr": "style",
            "template": "{{ scope.value | css_url }}"
          }
        }
      },
      "sortByTimestamp": true
    },
    "provider": {
      "title": "Telegram",
      "category": "social",
      "color": "blue"
    }
  },
  "tieba:hot-topic": {
    "baseUrl": "https://tieba.baidu.com/",
    "metadata": {
      "home": "/",
      "title": "热议",
      "type": "ranking"
    },
    "version": 3,
    "loader": {
      "type": "json",
      "url": "/hottopic/browse/topicList",
      "items": "data.bang_topic.topic_list",
      "fields": {
        "title": "topic_name",
        "url": {
          "select": "topic_url",
          "template": "{{ scope.value | replace: '&amp;', '&' }}"
        },
        "publishedAt": {
          "select": "create_time",
          "template": "{{ scope.value | times: 1000 }}"
        }
      }
    },
    "provider": {
      "title": "百度贴吧",
      "category": "forum",
      "color": "blue"
    }
  },
  "zaochenbao:realtime": {
    "baseUrl": "https://www.zaochenbao.com/",
    "metadata": {
      "home": "/realtime/",
      "title": "即时新闻"
    },
    "loader": {
      "type": "html",
      "url": "/realtime/",
      "decoding": "gb2312",
      "items": "div.list-block > a.item",
      "fields": {
        "title": ".eps",
        "url": {
          "attr": "href"
        },
        "publishedAt": {
          "select": ".pdt10",
          "template": "{{ scope.value | replace: '- ', 'T' | append: '+08:00' | date_to_ms }}"
        }
      },
      "sortByTimestamp": true
    },
    "provider": {
      "title": "早晨报",
      "category": "news",
      "color": "red"
    }
  },
  "zhihu:hot-list": {
    "baseUrl": "https://www.zhihu.com/",
    "metadata": {
      "home": "/",
      "title": "热榜",
      "type": "ranking"
    },
    "version": 3,
    "loader": {
      "type": "json",
      "url": "/api/v3/feed/topstory/hot-list-web?limit=50&desktop=true",
      "items": "data",
      "fields": {
        "title": "target.title_area.text",
        "url": "target.link.url",
        "mark": {
          "src": "card_label.night_icon",
          "kind": {
            "template": "trend"
          },
          "label": "card_label.text"
        },
        "content": {
          "text": "target.excerpt_area.text",
          "pictures": "target.image_area.url"
        }
      }
    },
    "provider": {
      "title": "知乎",
      "category": "forum",
      "color": "blue"
    }
  }
}
