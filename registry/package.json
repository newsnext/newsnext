{
  "name": "@newsnext/registry",
  "type": "module",
  "private": true,
  "license": "MPL-2.0",
  "sideEffects": false,
  "exports": {
    ".": "./registry.json",
    "./sources": {
      "types": "./sources.d.ts",
      "default": "./sources.js"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "build:watch": "bun --watch run build.ts",
    "typecheck": "bun check",
    "test:live": "vitest run --config vitest.live.config.js"
  },
  "dependencies": {
    "@newsnext/date-parser": "workspace:*",
    "@newsnext/source-kit": "workspace:*",
    "cheerio": "catalog:"
  },
  "devDependencies": {
    "@newsnext/sdk": "workspace:*",
    "@newsnext/tsconfigs": "workspace:*",
    "vitest": "catalog:"
  }
}
