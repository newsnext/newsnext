{
  "aihot:all": {
    "metadata": {
      "category": "tech",
      "color": "blue",
      "home": "https://aihot.virxact.com",
      "type": "timeline"
    },
    "loader": {
      "type": "json",
      "url": "https://aihot.virxact.com/api/public/items?mode=all&take=30",
      "items": "items[?id && title && url]",
      "fields": {
        "title": "title",
        "url": "url",
        "timestamp": {
          "select": "publishedAt",
          "template": "{{ value | date_to_ms }}"
        },
        "inline": {
          "text": {
            "template": "{{ item.source }}{% if item.category %} · {{ item.category }}{% endif %}"
          }
        },
        "preview": {
          "text": "summary"
        }
      }
    },
    "cache": "5m",
    "provider": {
      "title": "AIHot"
    }
  },
  "github:trending": {
    "metadata": {
      "category": "others",
      "home": "https://github.com/trending",
      "color": "slate",
      "title": "Trending",
      "type": "hottest"
    },
    "params": {
      "language": {
        "type": "text",
        "title": "Language",
        "description": "Programming language slug used by GitHub Trending, such as javascript, go, or rust.",
        "default": ""
      },
      "spokenLanguage": {
        "type": "text",
        "title": "Spoken Language",
        "description": "Repository description language code, such as en, zh, or ja.",
        "default": ""
      },
      "dateRange": {
        "type": "select",
        "title": "Date range",
        "values": [
          {
            "label": "Today",
            "value": "daily"
          },
          {
            "label": "This week",
            "value": "weekly"
          },
          {
            "label": "This month",
            "value": "monthly"
          }
        ],
        "default": "daily"
      }
    },
    "radar": [
      {
        "id": "github-trending",
        "match": {
          "hosts": [
            "github.com"
          ],
          "paths": [
            "/trending",
            "/trending/:language"
          ]
        },
        "patch": {
          "params": {
            "language": "{{ path.language }}",
            "spokenLanguage": "{{ query.spoken_language_code }}",
            "dateRange": "{{ query.since }}"
          },
          "metadata": {
            "title": "Trending {{ params.language }}"
          }
        },
        "confidence": 0.95
      }
    ],
    "loader": {
      "type": "html",
      "url": "https://github.com/trending{% if params.language %}/{{ params.language | url_path }}{% endif %}?since={{ params.dateRange | url_query }}{% if params.spokenLanguage %}&spoken_language_code={{ params.spokenLanguage | url_query }}{% endif %}",
      "items": "main .Box div[data-hpc] > article",
      "fields": {
        "title": {
          "select": ">h2 a",
          "template": "{{ value | normalize_whitespace }}"
        },
        "url": {
          "select": ">h2 a",
          "attr": "href",
          "template": "{{ value | absolute_url: requestUrl }}"
        },
        "inline": {
          "text": {
            "select": "[href$=stargazers]",
            "template": "✰ {{ value | normalize_whitespace }}"
          }
        },
        "preview": {
          "text": {
            "select": ">p",
            "template": "{{ value | normalize_whitespace }}"
          }
        }
      }
    },
    "cache": "15m",
    "provider": {
      "title": "GitHub"
    }
  },
  "hackernews:top": {
    "metadata": {
      "category": "others",
      "color": "orange",
      "home": "https://news.ycombinator.com/",
      "type": "hottest",
      "title": "Hottest"
    },
    "cache": "5m",
    "context": {
      "origin": "https://news.ycombinator.com"
    },
    "loader": {
      "type": "html",
      "url": "{{ context.origin }}/",
      "items": ".athing",
      "fields": {
        "title": ".titleline>a",
        "url": {
          "select": "",
          "attr": "id",
          "template": "{{ context.origin }}/item?id={{ value | url_query }}"
        },
        "timestamp": {
          "traverse": {
            "type": "next",
            "selector": "tr"
          },
          "select": ".age",
          "attr": "title",
          "template": "{{ value | split: ' ' | last | times: 1000 }}"
        },
        "inline": {
          "text": {
            "traverse": {
              "type": "next",
              "selector": "tr"
            },
            "select": ".score"
          },
          "icon": {
            "select": ".titleline>a",
            "attr": "href",
            "template": "{{ value | absolute_url: requestUrl | favicon_url }}"
          }
        }
      }
    },
    "provider": {
      "title": "Hacker News"
    }
  },
