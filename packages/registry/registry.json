  "linuxdo:latest": {
    "metadata": {
      "category": "tech",
      "color": "slate",
      "home": "https://linux.do",
      "title": "Latest",
      "type": "timeline"
    },
    "cache": "5m",
    "context": {
      "origin": "https://linux.do"
    },
    "loader": {
      "type": "json",
      "items": "topic_list.topics[?visible && !archived && !pinned]",
      "fields": {
        "title": "title",
        "url": {
          "select": "id",
          "template": "{{ context.origin }}/t/topic/{{ value | url_path }}"
        },
        "inline": {
          "icon": {
            "template": "{% assign user = json.users | where: 'username', item.last_poster_username | first %}{% if user and user.avatar_template %}{{ user.avatar_template | replace: '{size}', '48' | absolute_url: context.origin }}{% endif %}"
          }
        },
        "timestamp": {
          "select": "created_at",
          "template": "{{ value | date_to_ms }}"
        }
      },
      "url": "{{ context.origin }}/latest.json?order=created"
    },
    "provider": {
      "title": "Linux.do"
    }
  },
