{
  "title": "V2EX",
  "defaults": {
    "metadata": {
      "color": "slate",
      "home": "https://v2ex.com/"
    }
  },
  "sources": {
    "feed": {
      "params": {
        "feed": {
          "type": "text",
          "title": "Feed",
          "default": "ideas",
          "pattern": ".+"
        }
      },
      "radar": [
        {
          "id": "v2ex-feed",
          "match": {
            "hosts": [
              "v2ex.com"
            ],
            "paths": [
              "/go/:feed"
            ]
          },
          "patch": {
            "params": {
              "feed": "{{ path.feed }}"
            },
            "metadata": {
              "title": "{{ page.title | normalize_whitespace | regex_extract: '^.*[>›]\\\\s*(.+)$', 1 | default: params.feed }}"
            }
          },
          "confidence": 0.9
        }
      ],
      "loader": {
        "type": "json",
        "url": "https://www.v2ex.com/feed/{{ params.feed | url_path }}.json",
        "items": "items",
        "fields": {
          "title": "title",
          "timestamp": {
            "select": "date_modified || date_published",
            "template": "{{ value | date_to_ms }}"
          },
          "url": "url",
          "inline": {
            "icon": "author.avatar"
          },
          "preview": {
            "html": "content_html"
          }
        }
      },
      "cache": "5m"
    }
  }
}
