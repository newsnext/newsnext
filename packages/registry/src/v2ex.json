{
  "title": "V2EX",
  "category": "forum",
  "icon": "https://icons.folo.is/v2ex.com",
  "color": "slate",
  "defaults": {
    "metadata": {
      "home": "https://v2ex.com/"
    }
  },
  "sources": {
    "feed": {
      "params": {
        "feed": {
          "type": "text",
          "title": "节点",
          "default": "ideas",
          "pattern": ".+"
        }
      },
      "radar": [
        {
          "id": "v2ex-feed",
          "match": {
            "hosts": [
              "v2ex.com"
            ],
            "paths": [
              "/go/:feed"
            ]
          },
          "patch": {
            "params": {
              "feed": "{{ scope.path.feed }}"
            },
            "metadata": {
              "title": {
                "select": ".node-breadcrumb",
                "template": "{{ scope.value | regex_replace: '^V2EX\\\\s*[>›]\\\\s*', '' }}"
              }
            }
          },
          "confidence": 0.9
        }
      ],
      "loader": {
        "type": "json",
        "url": "https://www.v2ex.com/feed/{{ scope.params.feed | url_path }}.json",
        "items": "items",
        "fields": {
          "title": "title",
          "timestamp": {
            "select": "date_modified || date_published",
            "template": "{{ scope.value | date_to_ms }}"
          },
          "url": "url",
          "inline": {
            "icon": "author.avatar"
          },
          "preview": {
            "html": "content_html"
          }
        }
      },
      "cache": "5m"
    }
  }
}
