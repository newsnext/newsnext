{
  "title": "知乎",
  "home": "https://www.zhihu.com",
  "color": "blue",
  "sources": {
    "hot-list": {
      "metadata": {
        "title": "全站热榜",
        "type": "hottest"
      },
      "loader": {
        "type": "json",
        "url": "https://www.zhihu.com/api/v3/feed/topstory/hot-list-web?limit=50&desktop=true",
        "items": "data",
        "fields": {
          "title": "target.title_area.text",
          "url": "target.link.url",
          "inline": {
            "mark": "card_label.night_icon && {src: card_label.night_icon, radius: `0`}"
          },
          "preview": {
            "text": "target.excerpt_area.text",
            "picture": "target.image_area.url"
          }
        }
      },
      "cache": "5m"
    }
  }
}
