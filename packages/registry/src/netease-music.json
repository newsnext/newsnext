{
  "title": "网易云音乐",
  "category": "entertainment",
  "color": "red",
  "defaults": {
    "baseUrl": "https://music.163.com/",
    "cache": {
      "version": 3,
      "maxAge": "15m"
    },
    "metadata": {
      "home": "/"
    },
    "loader": {
      "type": "json",
      "url": "/api/playlist/detail?id={{ scope.params.id | url_query }}",
      "items": "(result.tracks || playlist.tracks)[:100]",
      "metadata": {
        "badge": "result.coverImgUrl",
        "desc": "result.description",
        "title": "result.name"
      },
      "fields": {
        "title": "name",
        "url": {
          "select": "id",
          "template": "/song?id={{ scope.value | url_query }}"
        },
        "attributes": {
          "artists": {
            "template": "{% assign artists = scope.item.ar | default: scope.item.artists %}{% for artist in artists %}{% unless forloop.first %} / {% endunless %}{{ artist.name }}{% endfor %}{% assign album = scope.item.al.name | default: scope.item.album.name %}{% if artists and album %} · {% endif %}{{ album | default: '' }}"
          }
        },
        "icon": {
          "src": "al.picUrl || album.picUrl",
          "kind": { "template": "cover" },
          "label": "al.name || album.name"
        },
        "content": {
          "pictures": "al.picUrl || album.picUrl"
        }
      },
      "itemTemplate": {
        "inline": "{{ scope.item.attributes.artists }}"
      }
    }
  },
  "sources": {
    "playlist": {
      "metadata": {
        "title": "歌单"
      },
      "params": {
        "id": {
          "type": "text",
          "default": "17990594711",
          "title": "歌单 ID"
        }
      },
      "radar": [
        {
          "id": "netease-music-playlist",
          "match": {
            "hosts": [
              "music.163.com",
              "y.music.163.com"
            ],
            "paths": {
              "include": [
                {
                  "regex": "#/playlist(?:\\?|$)"
                }
              ]
            }
          },
          "patch": {
            "params": {
              "id": "{{ scope.query.id | default: scope.hashQuery.id }}"
            },
            "metadata": {
              "title": "{% assign title = scope.page.title | regex_extract: '^(.+?)\\\\s*-\\\\s*歌单\\\\s*-\\\\s*网易云音乐$', 1 %}{% if title != empty %}{{ title }}{% else %}歌单 {{ scope.params.id }}{% endif %}"
            }
          },
          "confidence": 0.95
        }
      ],
      "loader": {
        "metadata": {
          "home": {
            "template": "/#/playlist?id={{ scope.params.id | url_query }}"
          }
        }
      }
    },
    "ranking": {
      "metadata": {
        "title": "排行榜"
      },
      "params": {
        "id": {
          "type": "text",
          "default": "19723756",
          "title": "排行榜 ID"
        }
      },
      "radar": [
        {
          "id": "netease-music-ranking",
          "match": {
            "hosts": [
              "music.163.com",
              "y.music.163.com"
            ],
            "paths": {
              "include": [
                {
                  "regex": "#/discover/toplist(?:\\?|$)"
                }
              ]
            }
          },
          "patch": {
            "params": {
              "id": "{{ scope.query.id | default: scope.hashQuery.id }}"
            },
            "metadata": {
              "title": "{% assign title = scope.page.title | regex_extract: '^(.+?)\\\\s*-\\\\s*排行榜\\\\s*-\\\\s*网易云音乐$', 1 %}{% if title != empty %}{{ title }}{% else %}排行榜 {{ scope.params.id }}{% endif %}"
            }
          },
          "confidence": 0.95
        }
      ],
      "loader": {
        "metadata": {
          "home": {
            "template": "/#/discover/toplist?id={{ scope.params.id | url_query }}"
          }
        }
      }
    }
  }
}
