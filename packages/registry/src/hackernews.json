{
  "title": "Hacker News",
  "category": "forum",
  "color": "orange",
  "defaults": {
    "baseUrl": "https://news.ycombinator.com/",
    "cache": "5m",
    "loader": {
      "type": "html",
      "url": "/",
      "items": ".athing",
      "fields": {
        "title": ".titleline>a",
        "url": {
          "select": "",
          "attr": "id",
          "template": "/item?id={{ scope.value | url_query }}"
        },
        "publishedAt": {
          "traverse": {
            "type": "next",
            "selector": "tr"
          },
          "select": ".age",
          "attr": "title",
          "template": "{{ scope.value | split: ' ' | last | times: 1000 }}"
        },
        "author": {
          "name": {
            "traverse": {
              "type": "next",
              "selector": "tr"
            },
            "select": ".hnuser"
          }
        },
        "stats": {
          "score": {
            "traverse": {
              "type": "next",
              "selector": "tr"
            },
            "select": ".score",
            "template": "{{ scope.value | regex_extract: '(\\d+)', 1 }}"
          },
          "comments": {
            "traverse": {
              "type": "next",
              "selector": "tr"
            },
            "select": "a[href^='item?id=']:last-child",
            "template": "{{ scope.value | regex_extract: '(\\d+) comment', 1 }}"
          }
        },
        "icon": {
          "src": {
            "select": ".titleline>a",
            "attr": "href",
            "template": "{{ scope.value | absolute_url: scope.request.url | favicon_url }}"
          },
          "kind": { "template": "site" },
          "label": ".sitestr"
        }
      },
      "itemTemplate": {
        "inline": "{% if scope.item.author %}{{ scope.item.author.name }} · {% endif %}{{ scope.item.stats.score | compact_number }} points{% if scope.item.stats.comments != nil %} · {{ scope.item.stats.comments | compact_number }} comments{% endif %}"
      }
    },
    "metadata": {
      "home": "/"
    }
  },
  "sources": {
    "top": {
      "metadata": {
        "title": "Hottest"
      }
    },
    "newest": {
      "metadata": {
        "title": "Newest",
        "home": "/newest"
      },
      "loader": {
        "url": "/newest"
      },
      "cache": "1m"
    },
    "show": {
      "metadata": {
        "title": "Show",
        "home": "/show"
      },
      "loader": {
        "url": "/show"
      }
    },
    "ask": {
      "metadata": {
        "title": "Ask",
        "home": "/ask"
      },
      "loader": {
        "url": "/ask"
      }
    }
  }
}
