{
  "title": "Hacker News",
  "color": "orange",
  "home": "https://news.ycombinator.com/",
  "sources": {
    "top": {
      "metadata": {
        "type": "hottest",
        "title": "Hottest"
      },
      "loader": {
        "type": "html",
        "url": "https://news.ycombinator.com/",
        "items": ".athing",
        "fields": {
          "title": ".titleline>a",
          "url": {
            "select": "",
            "attr": "id",
            "template": "https://news.ycombinator.com/item?id={{ value | url_query }}"
          },
          "timestamp": {
            "traverse": {
              "type": "next",
              "selector": "tr"
            },
            "select": ".age",
            "attr": "title",
            "template": "{{ value | split: ' ' | last | times: 1000 }}"
          },
          "inline": {
            "text": {
              "traverse": {
                "type": "next",
                "selector": "tr"
              },
              "select": ".score"
            },
            "icon": {
              "select": ".titleline>a",
              "attr": "href",
              "template": "{{ value | absolute_url: requestUrl | favicon_url }}"
            }
          }
        }
      },
      "cache": "5m"
    },
