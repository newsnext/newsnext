{
  "title": "Hacker News",
  "defaults": {
    "cache": "5m",
    "context": {
      "origin": "https://news.ycombinator.com"
    },
    "loader": {
      "type": "html",
      "url": "{{ context.origin }}/",
      "items": ".athing",
      "fields": {
        "title": ".titleline>a",
        "url": {
          "select": "",
          "attr": "id",
          "template": "{{ context.origin }}/item?id={{ value | url_query }}"
        },
        "timestamp": {
          "traverse": {
            "type": "next",
            "selector": "tr"
          },
          "select": ".age",
          "attr": "title",
          "template": "{{ value | split: ' ' | last | times: 1000 }}"
        },
        "inline": {
          "text": {
            "traverse": {
              "type": "next",
              "selector": "tr"
            },
            "select": ".score"
          },
          "icon": {
            "select": ".titleline>a",
            "attr": "href",
            "template": "{{ value | absolute_url: requestUrl | favicon_url }}"
          }
        }
      }
    },
    "metadata": {
      "color": "orange",
      "home": "https://news.ycombinator.com/"
    }
  },
  "sources": {
    "top": {
      "metadata": {
        "type": "hottest",
        "title": "Hottest"
      }
    },
    "newest": {
      "metadata": {
        "type": "timeline",
        "title": "Newest",
        "home": "https://news.ycombinator.com/newest"
      },
      "loader": {
        "url": "{{ context.origin }}/newest"
      },
      "cache": "1m"
    },
    "show": {
      "metadata": {
        "title": "Show",
        "home": "https://news.ycombinator.com/show"
      },
      "loader": {
        "url": "{{ context.origin }}/show"
      }
    },
    "ask": {
      "metadata": {
        "title": "Ask",
        "home": "https://news.ycombinator.com/ask"
      },
      "loader": {
        "url": "{{ context.origin }}/ask"
      }
    }
  }
}
