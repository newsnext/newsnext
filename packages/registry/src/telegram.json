{
  "title": "Telegram",
  "category": "social",
  "color": "blue",
  "defaults": {
    "baseUrl": "https://t.me/",
    "metadata": {
      "home": "/"
    }
  },
  "sources": {
    "channel": {
      "metadata": {
        "title": "频道"
      },
      "params": {
        "channel": {
          "type": "text",
          "default": "TestFlightCN",
          "title": "Channel"
        }
      },
      "radar": [
        {
          "id": "telegram-channel",
          "match": {
            "hosts": [
              "t.me",
              "telegram.me"
            ],
            "paths": [
              "/s/:channel",
              "/:channel"
            ]
          },
          "patch": {
            "params": {
              "channel": "{{ scope.path.channel }}"
            },
            "metadata": {
              "title": {
                "select": ".tgme_channel_info_header_title"
              },
              "badge": "/i/userpic/320/{{ scope.params.channel | url_path }}.jpg",
              "home": "/s/{{ scope.params.channel }}"
            }
          },
          "confidence": 0.95
        }
      ],
      "loader": {
        "type": "html",
        "url": "/s/{{ scope.params.channel | url_path }}",
        "items": ".tgme_widget_message:has(.tgme_widget_message_text)",
        "fields": {
          "title": {
            "select": ".tgme_widget_message_text",
            "brSeparator": "\n",
            "template": "{{ scope.value | first_line | truncate: 160, '…' }}"
          },
          "url": {
            "select": ".tgme_widget_message_date",
            "attr": "href"
          },
          "timestamp": {
            "select": ".tgme_widget_message_date time",
            "attr": "datetime",
            "template": "{{ scope.value | date_to_ms }}"
          },
          "inline": {
            "text": {
              "select": ".tgme_widget_message_views",
              "template": "{% if scope.value %}{{ scope.value }} views{% endif %}"
            }
          },
          "preview": {
            "text": {
              "select": ".tgme_widget_message_text",
              "brSeparator": "\n",
              "template": "{{ scope.value | normalize_lines: 2 }}"
            },
            "picture": {
              "select": ".tgme_widget_message_photo_wrap, .tgme_widget_message_video_thumb",
              "attr": "style",
              "template": "{{ scope.value | css_url }}"
            }
          }
        }
      },
      "cache": "5m"
    }
  }
}
