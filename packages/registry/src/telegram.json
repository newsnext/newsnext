{
  "title": "Telegram",
  "defaults": {
    "metadata": {
      "color": "blue",
      "home": "https://t.me/s/TestFlightCN",
      "category": "tech"
    }
  },
  "sources": {
    "channel": {
      "metadata": {
        "title": "科技圈 在花频道",
        "type": "timeline"
      },
      "params": {
        "channel": {
          "type": "text",
          "default": "TestFlightCN",
          "title": "Channel",
          "pattern": "^(?![\\d_])\\w{5,32}$",
          "template": "{{ scope.value | remove_first: '@' }}"
        }
      },
      "radar": [
        {
          "id": "telegram-channel",
          "match": {
            "hosts": [
              "t.me",
              "telegram.me"
            ],
            "paths": [
              "/s/:channel",
              "/:channel"
            ]
          },
          "patch": {
            "params": {
              "channel": "{{ scope.path.channel }}"
            },
            "metadata": {
              "title": "{{ scope.page.title | normalize_whitespace | regex_replace: '\\\\s*[–-]\\\\s*Telegram$', '' | default: 'Telegram channel' }}",
              "badge": "https://t.me/i/userpic/320/{{ scope.params.channel | url_path }}.jpg",
              "home": "https://t.me/s/{{ scope.params.channel }}"
            }
          },
          "confidence": 0.95
        }
      ],
      "loader": {
        "type": "html",
        "url": "https://t.me/s/{{ scope.params.channel | url_path }}",
        "items": ".tgme_widget_message:has(.tgme_widget_message_text)",
        "fields": {
          "title": {
            "select": ".tgme_widget_message_text",
            "brSeparator": "\n",
            "template": "{{ scope.value | first_line | truncate: 160, '…' }}"
          },
          "url": {
            "select": ".tgme_widget_message_date",
            "attr": "href",
            "template": "{{ scope.value | absolute_url: scope.request.url }}"
          },
          "timestamp": {
            "select": ".tgme_widget_message_date time",
            "attr": "datetime",
            "template": "{{ scope.value | date_to_ms }}"
          },
          "inline": {
            "text": {
              "select": ".tgme_widget_message_views",
              "template": "{% if scope.value %}{{ scope.value }} views{% endif %}"
            }
          },
          "preview": {
            "text": {
              "select": ".tgme_widget_message_text",
              "brSeparator": "\n",
              "template": "{{ scope.value | normalize_lines: 2 }}"
            },
            "picture": {
              "select": ".tgme_widget_message_photo_wrap, .tgme_widget_message_video_thumb",
              "attr": "style",
              "template": "{{ scope.value | css_url }}"
            }
          }
        }
      },
      "cache": "5m"
    }
  }
}
