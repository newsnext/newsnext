{
  "title": "AIHot",
  "category": "news",
  "color": "blue",
  "defaults": {
    "baseUrl": "https://aihot.virxact.com/",
    "metadata": {
      "home": "/"
    }
  },
  "sources": {
    "all": {
      "metadata": {
        "type": "timeline"
      },
      "loader": {
        "type": "json",
        "url": "/api/public/items?mode=all&take=30",
        "items": "items[?id && title && url]",
        "fields": {
          "title": "title",
          "url": "url",
          "timestamp": {
            "select": "publishedAt",
            "template": "{{ scope.value | date_to_ms }}"
          },
          "inline": {
            "text": {
              "template": "{{ scope.item.source }}{% if scope.item.category %} · {{ scope.item.category }}{% endif %}"
            }
          },
          "preview": {
            "text": "summary"
          }
        }
      },
      "cache": "5m"
    }
  }
}
