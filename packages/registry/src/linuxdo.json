{
  "title": "Linux.do",
  "category": "forum",
  "color": "slate",
  "defaults": {
    "baseUrl": "https://linux.do/",
    "cache": "5m",
    "loader": {
      "type": "json",
      "items": "topic_list.topics[?visible && !archived && !pinned]",
      "fields": {
        "title": "title",
        "url": {
          "select": "id",
          "template": "/t/topic/{{ scope.value | url_path }}"
        },
        "inline": {
          "icon": {
            "template": "{% assign user = scope.response.json.users | where: 'username', scope.item.last_poster_username | first %}{% if user and user.avatar_template %}{{ user.avatar_template | replace: '{size}', '48' }}{% endif %}"
          }
        }
      }
    },
    "metadata": {
      "home": "/"
    }
  },
  "sources": {
    "latest": {
      "metadata": {
        "title": "最新",
        "type": "timeline"
      },
      "loader": {
        "url": "/latest.json?order=created",
        "fields": {
          "timestamp": {
            "select": "created_at",
            "template": "{{ scope.value | date_to_ms }}"
          }
        }
      }
    },
    "top-daily": {
      "metadata": {
        "title": "热门",
        "type": "hottest"
      },
      "loader": {
        "url": "/top/daily.json"
      }
    }
  }
}
