{
  "title": "百度贴吧",
  "home": "https://tieba.baidu.com",
  "color": "blue",
  "category": "china",
  "sources": {
    "hot-topic": {
      "metadata": {
        "title": "热议",
        "type": "hottest"
      },
      "loader": {
        "type": "json",
        "url": "https://tieba.baidu.com/hottopic/browse/topicList",
        "items": "data.bang_topic.topic_list",
        "fields": {
          "title": "topic_name",
          "url": {
            "select": "topic_url",
            "template": "{{ value | replace: '&amp;', '&' | absolute_url: requestUrl }}"
          },
          "timestamp": {
            "select": "create_time",
            "template": "{{ value | times: 1000 }}"
          }
        }
      },
      "cache": "5m"
    }
  }
}
