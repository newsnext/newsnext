{
  "title": "百度贴吧",
  "category": "forum",
  "icon": "https://icons.folo.is/tieba.baidu.com",
  "color": "blue",
  "defaults": {
    "metadata": {
      "home": "https://tieba.baidu.com"
    }
  },
  "sources": {
    "hot-topic": {
      "metadata": {
        "title": "热议",
        "type": "hottest"
      },
      "loader": {
        "type": "json",
        "url": "https://tieba.baidu.com/hottopic/browse/topicList",
        "items": "data.bang_topic.topic_list",
        "fields": {
          "title": "topic_name",
          "url": {
            "select": "topic_url",
            "template": "{{ scope.value | replace: '&amp;', '&' | absolute_url: scope.request.url }}"
          },
          "timestamp": {
            "select": "create_time",
            "template": "{{ scope.value | times: 1000 }}"
          }
        }
      },
      "cache": "5m"
    }
  }
}
