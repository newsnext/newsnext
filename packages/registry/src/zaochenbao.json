{
  "title": "早晨报",
  "category": "news",
  "color": "red",
  "defaults": {
    "metadata": {
      "home": "https://www.zaochenbao.com"
    }
  },
  "sources": {
    "realtime": {
      "metadata": {
        "title": "即时新闻",
        "type": "timeline",
        "home": "https://www.zaochenbao.com/realtime/"
      },
      "loader": {
        "type": "html",
        "url": "https://www.zaochenbao.com/realtime/",
        "decoding": "gb2312",
        "items": "div.list-block > a.item",
        "fields": {
          "title": ".eps",
          "url": {
            "attr": "href",
            "template": "{{ scope.value | absolute_url: scope.request.url }}"
          },
          "timestamp": {
            "select": ".pdt10",
            "template": "{{ scope.value | replace: '- ', 'T' | append: '+08:00' | date_to_ms }}"
          }
        }
      },
      "cache": "5m"
    }
  }
}
