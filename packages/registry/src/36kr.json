{
  "title": "36氪",
  "defaults": {
    "metadata": {
      "home": "https://36kr.com",
      "color": "blue",
      "category": "tech"
    },
    "cache": "5m"
  },
  "sources": {
    "information": {
      "metadata": {
        "title": "资讯",
        "home": "https://36kr.com/information/web_news/latest/",
        "type": "timeline"
      },
      "params": {
        "channel": {
          "type": "select",
          "title": "栏目",
          "values": [
            {
              "label": "最新",
              "value": "web_news"
            },
            {
              "label": "推荐",
              "value": "web_recommend"
            },
            {
              "label": "创投",
              "value": "contact"
            },
            {
              "label": "财经",
              "value": "ccs"
            },
            {
              "label": "汽车",
              "value": "travel"
            },
            {
              "label": "AI",
              "value": "AI"
            },
            {
              "label": "科技",
              "value": "technology"
            },
            {
              "label": "专精特新",
              "value": "shuzihua"
            },
            {
              "label": "创新",
              "value": "innovate"
            },
            {
              "label": "企服",
              "value": "enterpriseservice"
            },
            {
              "label": "消费",
              "value": "happy_life"
            },
            {
              "label": "城市",
              "value": "real_estate"
            },
            {
              "label": "职场",
              "value": "web_zhichang"
            }
          ],
          "default": "web_news"
        }
      },
      "radar": [
        {
          "id": "36kr-information",
          "match": {
            "hosts": [
              "36kr.com"
            ],
            "paths": [
              "/information/:channel",
              "/information/:channel/*rest"
            ]
          },
          "patch": {
            "params": {
              "channel": "{{ path.channel }}"
            }
          },
          "confidence": 0.9
        }
      ],
      "loader": {
        "type": "json",
        "url": "https://gateway.36kr.com/api/mis/nav/ifm/subNav/flow",
        "fetchOptions": {
          "method": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "partner_id": "web",
            "param": {
              "subnavType": 1,
              "subnavNick": "{{ params.channel }}",
              "pageSize": 30,
              "pageEvent": 0,
              "siteId": 1,
              "platformId": 2
            }
          }
        },
        "items": "data.itemList[?itemType == `10`]",
        "fields": {
          "title": "templateMaterial.widgetTitle",
          "url": {
            "select": "itemId",
            "template": "https://36kr.com/p/{{ value }}"
          },
          "timestamp": "templateMaterial.publishTime",
          "inline": {
            "text": "templateMaterial.authorName"
          },
          "preview": {
            "text": "templateMaterial.summary",
            "picture": "templateMaterial.widgetImage"
          }
        }
      }
    },
    "newsflashes": {
      "metadata": {
        "title": "快讯",
        "home": "https://36kr.com/newsflashes/catalog/0",
        "type": "timeline"
      },
      "params": {
        "category": {
          "type": "select",
          "title": "分类",
          "values": [
            {
              "label": "全部",
              "value": "0"
            },
            {
              "label": "热点",
              "value": "1"
            },
            {
              "label": "股市",
              "value": "2"
            },
            {
              "label": "公司",
              "value": "3"
            },
            {
              "label": "宏观",
              "value": "4"
            }
          ],
          "default": "0"
        }
      },
      "radar": [
        {
          "id": "36kr-newsflashes",
          "match": {
            "hosts": [
              "36kr.com"
            ],
            "paths": [
              "/newsflashes",
              "/newsflashes/:id",
              "/newsflashes/catalog/:type"
            ]
          },
          "patch": {
            "params": {
              "category": "{% if path.type %}{{ path.type }}{% else %}0{% endif %}"
            },
            "metadata": {
              "title": "快讯 · {% if params.category == '1' %}热点{% elsif params.category == '2' %}股市{% elsif params.category == '3' %}公司{% elsif params.category == '4' %}宏观{% else %}全部{% endif %}"
            }
          },
          "confidence": 0.9
        }
      ],
      "loader": {
        "type": "html",
        "url": "https://36kr.com/newsflashes/catalog/{{ params.category | url_path }}",
        "items": ".newsflash-item",
        "fields": {
          "title": ".item-title",
          "url": {
            "select": ".item-title",
            "attr": "href",
            "template": "{{ value | absolute_url: requestUrl }}"
          },
          "timestamp": {
            "select": ".time",
            "template": "{{ value | relative_date_to_ms: 'Asia/Shanghai' }}"
          },
          "preview": {
            "text": ".item-desc > span"
          }
        }
      }
    },
    "hot-list": {
      "metadata": {
        "title": "人气榜",
        "home": "https://36kr.com/hot-list/catalog",
        "type": "hottest"
      },
      "radar": [
        {
          "id": "36kr-hot-list",
          "match": {
            "hosts": [
              "36kr.com"
            ],
            "paths": [
              "/hot-list/*rest"
            ]
          },
          "confidence": 0.9
        }
      ],
      "loader": {
        "type": "json",
        "url": "https://gateway.36kr.com/api/mis/x/rank/list",
        "fetchOptions": {
          "method": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "partner_id": "web",
            "param": {
              "siteId": 1,
              "platformId": 2
            }
          }
        },
        "items": "data.topList",
        "fields": {
          "title": "widgetTitle",
          "url": {
            "select": "itemId",
            "template": "https://36kr.com/p/{{ value }}"
          },
          "timestamp": "publishTime",
          "inline": {
            "text": {
              "template": "{{ item.statHot }}w 热度 · {{ item.authorName }}"
            }
          },
          "preview": {
            "text": "summary",
            "picture": "widgetImage"
          }
        }
      }
    }
  }
}
