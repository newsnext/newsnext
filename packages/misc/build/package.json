{
  "name": "@newsnext/build",
  "type": "module",
  "private": true,
  "license": "MPL-2.0",
  "keywords": [
    "rolldown",
    "build",
    "plugin",
    "hono"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./adapters/bun": "./dist/adapters/bun/index.mjs",
    "./adapters/cloudflare-workers": "./dist/adapters/cloudflare-workers/index.mjs",
    "./adapters/netlify": "./dist/adapters/netlify/index.mjs",
    "./adapters/vercel": "./dist/adapters/vercel/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.mts",
        "./*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsgo --noEmit"
  },
  "peerDependencies": {
    "rolldown": ">=1.0.0-rc"
  }
}
