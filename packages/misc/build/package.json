{
  "name": "@newsnext/build",
  "type": "module",
  "private": true,
  "license": "MPL-2.0",
  "keywords": [
    "unplugin",
    "vite",
    "rollup",
    "rolldown",
    "esbuild"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./adapter/bun": "./dist/adapter/bun/index.mjs",
    "./adapter/cloudflare-workers": "./dist/adapter/cloudflare-workers/index.mjs",
    "./adapter/netlify-functions": "./dist/adapter/netlify-functions/index.mjs",
    "./adapter/vercel": "./dist/adapter/vercel/index.mjs",
    "./api": "./dist/api.mjs",
    "./entry": "./dist/entry.mjs",
    "./esbuild": "./dist/esbuild.mjs",
    "./rolldown": "./dist/rolldown.mjs",
    "./rollup": "./dist/rollup.mjs",
    "./vite": "./dist/vite.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.mts",
        "./*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "unplugin": "^2.3.11"
  }
}
