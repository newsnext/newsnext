{
  "name": "@newsnext/sdk",
  "type": "module",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Typed programmatic access to the NewsNext CLI",
  "license": "MPL-2.0",
  "exports": {
    ".": {
      "browser": "./src/widget.ts",
      "default": "./src/index.ts"
    },
    "./models": "./src/models/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./actions": "./src/action/index.ts",
    "./extension": "./src/extension.ts",
    "./widget": "./src/widget.ts",
    "./analytics": "./src/analytics.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun scripts/generate-json-schemas.ts --check && tsdown && bun scripts/generate-actions-reference.ts && bun scripts/vendor-sdk-bundle.ts",
    "schemas:generate": "bun scripts/generate-json-schemas.ts",
    "schemas:check": "bun scripts/generate-json-schemas.ts --check",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@wxt-dev/browser": "^0.2.9",
    "typebox": "^1.3.29"
  },
  "devDependencies": {
    "@newsnext/shared": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "vitest": "catalog:"
  }
}
