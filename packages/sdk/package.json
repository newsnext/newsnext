{
  "name": "@newsnext/sdk",
  "type": "module",
  "version": "1.0.0-alpha.1",
  "description": "Typed programmatic access to the NewsNext CLI",
  "license": "MPL-2.0",
  "exports": {
    ".": {
      "browser": "./src/widget.ts",
      "default": "./src/index.ts"
    },
    "./models": "./src/models/index.ts",
    "./actions": "./src/action/index.ts",
    "./widget": "./src/widget.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun run package.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@newsnext/shared": "workspace:*",
    "@types/react": "^19.2.18",
    "@wxt-dev/browser": "^0.2.9",
    "typebox": "^1.3.29"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
