{
  "name": "newsnext",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MPL-2.0",
  "workspaces": {
    "packages": [
      "apps/extension",
      "packages/**",
      "servers/**"
    ],
    "catalog": {
      "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
      "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.1.5",
      "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.2.0",
      "@iconify-json/ph": "^1.2.2",
      "@orpc/client": "^1.14.5",
      "@orpc/server": "^1.14.5",
      "@orpc/tanstack-query": "^1.14.5",
      "@tailwindcss/vite": "^4.1.18",
      "@tanstack/react-query": "^5.101.0",
      "@tanstack/react-query-devtools": "^5.101.0",
      "@tanstack/react-router": "^1.170.15",
      "@tanstack/react-router-devtools": "^1.167.0",
      "@tanstack/react-virtual": "^3.14.2",
      "@vitejs/plugin-react": "^6.0.2",
      "better-auth": "^1.6.15",
      "date-fns": "^4.4.0",
      "defu": "^6.1.7",
      "es-toolkit": "^1.47.0",
      "jotai": "^2.20.0",
      "lucide-react": "^1.17.0",
      "motion": "^12.40.0",
      "nitro": "3.0.260522-beta",
      "ofetch": "2.0.0-alpha.3",
      "react": "^19.2.1",
      "react-device-detect": "^2.2.3",
      "react-dom": "^19.2.1",
      "react-scan": "^0.5.7",
      "tailwindcss": "^4.1.18",
      "unplugin-icons": "^23.0.1",
      "unplugin-turbo-console": "^2.3.2",
      "vite": "^8.0.16",
      "zod": "^4.4.3"
    }
  },
  "scripts": {
    "lint": "bun run --bun eslint .",
    "test": "vitest",
    "prepare": "simple-git-hooks",
    "cli": "bun run apps/cli/src/index.ts",
    "dev": "bun run dev:server & bun run dev:web & wait",
    "dev:instance": "bun --filter=@newsnext/instance run dev",
    "dev:server": "bun --filter=@newsnext/api run dev",
    "dev:api": "bun run dev:server",
    "dev:web": "bun --filter=@newsnext/web run dev",
    "build:instance": "bun --filter=@newsnext/instance run build",
    "build:server": "bun --filter=@newsnext/api run build:cloudflare",
    "build:web": "VITE_BASE_URL=https://api.newsnext.pro/v1 bun --filter=@newsnext/web run build",
    "deploy:server": "bun --filter=@newsnext/api run deploy:cloudflare",
    "deploy:web": "bun run build:web && bun --filter=@newsnext/web run deploy:cloudflare",
    "deploy:cloudflare": "bun run deploy:server && bun run deploy:web",
    "docker:build": "bun run docker:build:api && bun run docker:build:web",
    "docker:build:api": "docker build --target api -t newsnext-api:latest .",
    "docker:build:web": "docker build --target web -t newsnext-web:latest .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "dev:chrome": "bun --filter=@newsnext/extension run dev:chrome"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@eslint/js": "^9.39.4",
    "@newsnext/tsconfigs": "workspace:*",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "lint-staged": "^17.0.8",
    "mockdate": "^3.0.5",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0",
    "vercel": "^54.21.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.1"
  },
  "overrides": {
    "@atlaskit/pragmatic-drag-and-drop": "catalog:",
    "@better-auth/utils": "0.4.1",
    "defu": "catalog:",
    "env-runner": "0.1.13",
    "es-toolkit": "catalog:",
    "iconv-lite": "^0.7.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "^8.1.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
