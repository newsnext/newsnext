{
  "name": "newsnext",
  "type": "module",
  "version": "1.0.0-alpha.1",
  "private": true,
  "license": "MPL-2.0",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "registry"
    ],
    "catalog": {
      "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
      "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.0.0",
      "@cloudflare/vite-plugin": "^1.54.6",
      "@iconify-json/ph": "^1.2.2",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-devtools": "^0.10.12",
      "@tanstack/react-hotkeys": "^0.10.0",
      "@tanstack/react-query": "^5.102.8",
      "@tanstack/react-query-devtools": "^5.102.8",
      "@tanstack/react-router": "^1.170.33",
      "@tanstack/react-router-devtools": "^1.167.1",
      "@tanstack/react-start": "^1.168.50",
      "@tanstack/react-virtual": "^3.14.11",
      "@types/node": "^26.5.0",
      "@vitejs/plugin-react": "^6.1.1",
      "@wxt-dev/browser": "^0.2.9",
      "cheerio": "^1.2.0",
      "cn": "^0.2.6",
      "date-fns": "^4.4.0",
      "defu": "^6.1.7",
      "es-toolkit": "^1.52.0",
      "gridstack": "^13.2.0",
      "jotai": "^3.0.0",
      "ky": "^2.1.0",
      "lucide-react": "^1.43.0",
      "motion": "^13.2.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "tailwindcss": "^4.3.3",
      "unplugin-icons": "^23.0.1",
      "unplugin-turbo-console": "^2.3.3",
      "vite": "^8.2.2",
      "vitest": "^5.0.0",
      "wrangler": "^4.130.0"
    }
  },
  "scripts": {
    "lint": "bun run --bun eslint .",
    "test": "vitest",
    "typecheck": "tsc -b --noEmit",
    "prepare": "simple-git-hooks",
    "dev": "bun --filter=@newsnext/extension run dev",
    "dev:yolo": "bun --filter=@newsnext/extension run dev:yolo",
    "dev:chrome": "bun --filter=@newsnext/extension run dev:chrome",
    "dev:firefox": "bun --filter=@newsnext/extension run dev:firefox",
    "landing:dev": "bun --filter=@newsnext/landing run dev",
    "landing:build": "bun --filter=@newsnext/landing run build",
    "landing:deploy": "bun --filter=@newsnext/landing run deploy",
    "update-deps": "taze -r -w && bun install",
    "release": "bumpp --recursive --install --all --git-check",
    "build": "bun --filter=@newsnext/extension run build",
    "build:chrome": "bun --filter=@newsnext/extension run build:chrome",
    "build:firefox": "bun --filter=@newsnext/extension run build:firefox"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/js": "^10.0.1",
    "@newsnext/tsconfigs": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "lint-staged": "^17.5.0",
    "simple-git-hooks": "^2.14.0",
    "taze": "^21.1.0",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
