{
  "name": "newsnext",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MPL-2.0",
  "workspaces": {
    "packages": [
      "apps/**",
      "packages/**",
      "servers/**"
    ],
    "catalog": {
      "@tailwindcss/vite": "^4.1.18",
      "react": "^19.2.1",
      "react-dom": "^19.2.1",
      "tailwindcss": "^4.1.18"
    }
  },
  "scripts": {
    "lint": "bun run --bun eslint .",
    "test": "vitest",
    "cli": "bun run apps/cli/src/index.ts",
    "dev": "bun run dev:server & bun run dev:web & wait",
    "dev:instance": "bun --filter=@newsnext/instance run dev",
    "dev:server": "bun --filter=@newsnext/api run dev",
    "dev:api": "bun run dev:server",
    "dev:web": "bun --filter=@newsnext/web run dev",
    "build:instance": "bun --filter=@newsnext/instance run build",
    "build:server": "bun --filter=@newsnext/api run build:cloudflare",
    "build:web": "VITE_BASE_URL=https://api.newsnext.pro bun --filter=@newsnext/web run build",
    "deploy:server": "bun --filter=@newsnext/api run deploy:cloudflare",
    "deploy:web": "bun run build:web && bun --filter=@newsnext/web run deploy:cloudflare",
    "deploy:cloudflare": "bun run deploy:server && bun run deploy:web",
    "docker:build": "bun run docker:build:api && bun run docker:build:web",
    "docker:build:api": "docker build --target api -t newsnext-api:latest .",
    "docker:build:web": "docker build --target web -t newsnext-web:latest .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "dev:chrome": "bun --filter=@newsnext/extension run dev:chrome"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "ofetch": "^1.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@eslint/js": "^9.39.4",
    "@newsnext/tsconfigs": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260609.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "mockdate": "^3.0.5",
    "tsdown": "^0.22.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "vercel": "^54.10.2",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  },
  "overrides": {
    "iconv-lite": "^0.7.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "^8.0.16"
  },
  "patchedDependencies": {
    "env-runner@0.1.9": "patches/env-runner@0.1.9.patch"
  }
}
