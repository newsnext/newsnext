{
  "name": "newsnext",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MPL-2.0",
  "workspaces": {
    "packages": [
      "apps/extension",
      "packages/misc/tsconfigs",
      "packages/shared",
      "packages/source",
      "packages/ui"
    ],
    "catalog": {
      "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
      "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.1.5",
      "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.2.0",
      "@iconify-json/ph": "^1.2.2",
      "@tailwindcss/vite": "^4.1.18",
      "@tanstack/react-query": "^5.101.0",
      "@tanstack/react-query-devtools": "^5.101.0",
      "@tanstack/react-router": "^1.170.15",
      "@tanstack/react-router-devtools": "^1.167.0",
      "@tanstack/react-virtual": "^3.14.2",
      "@vitejs/plugin-react": "^6.0.2",
      "date-fns": "^4.4.0",
      "defu": "^6.1.7",
      "es-toolkit": "^1.47.0",
      "jotai": "^2.20.0",
      "lucide-react": "^1.17.0",
      "motion": "^12.40.0",
      "ofetch": "2.0.0-alpha.3",
      "react": "^19.2.1",
      "react-dom": "^19.2.1",
      "tailwindcss": "^4.1.18",
      "unplugin-icons": "^23.0.1",
      "unplugin-turbo-console": "^2.3.2",
      "vite": "^8.0.16",
      "zod": "^4.4.3"
    }
  },
  "scripts": {
    "lint": "bun run --bun eslint .",
    "test": "vitest",
    "prepare": "simple-git-hooks",
    "dev": "bun --filter=@newsnext/extension run dev",
    "dev:chrome": "bun --filter=@newsnext/extension run dev:chrome",
    "dev:firefox": "bun --filter=@newsnext/extension run dev:firefox",
    "build": "bun --filter=@newsnext/extension run build",
    "build:chrome": "bun --filter=@newsnext/extension run build:chrome",
    "build:firefox": "bun --filter=@newsnext/extension run build:firefox"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@eslint/js": "^9.39.4",
    "@newsnext/tsconfigs": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "lint-staged": "^17.0.8",
    "mockdate": "^3.0.5",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@atlaskit/pragmatic-drag-and-drop": "catalog:",
    "defu": "catalog:",
    "es-toolkit": "catalog:",
    "iconv-lite": "^0.7.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "^8.1.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
