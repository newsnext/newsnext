{
  "name": "newsnext",
  "type": "module",
  "version": "1.0.0-alpha.1",
  "private": true,
  "license": "MPL-2.0",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
      "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.0.0",
      "@cloudflare/vite-plugin": "^1.64.0",
      "@iconify-json/ph": "^1.2.2",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-devtools": "^0.10.13",
      "@tanstack/react-hotkeys": "^0.10.0",
      "@tanstack/react-query": "^5.104.3",
      "@tanstack/react-query-devtools": "^5.104.3",
      "@tanstack/react-router": "^1.170.44",
      "@tanstack/react-router-devtools": "^1.167.2",
      "@tanstack/react-virtual": "^3.14.19",
      "@types/node": "^26.6.5",
      "@vitejs/plugin-react": "^6.1.2",
      "@wxt-dev/browser": "^0.2.9",
      "cheerio": "^1.2.0",
      "cn": "^0.2.6",
      "date-fns": "^4.4.0",
      "defu": "^6.1.7",
      "es-toolkit": "^1.52.0",
      "jotai": "^3.0.1",
      "ky": "^2.2.0",
      "lucide-react": "^1.57.0",
      "motion": "^13.5.1",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "tailwindcss": "^4.3.3",
      "unplugin-icons": "^23.0.1",
      "unplugin-turbo-console": "^2.3.3",
      "vite": "^8.3.4",
      "vitest": "^5.0.4",
      "wrangler": "^4.151.0"
    }
  },
  "scripts": {
    "registry:validate": "bun scripts/validate-registry.ts",
    "lint": "bun run --bun eslint .",
    "test": "vitest",
    "typecheck": "bun --filter=@newsnext/sdk run schemas:check && bun check -b",
    "prepare": "simple-git-hooks",
    "dev": "bun --filter=@newsnext/extension run dev",
    "dev:yolo": "bun --filter=@newsnext/extension run dev:yolo",
    "dev:chrome": "bun --filter=@newsnext/extension run dev:chrome",
    "dev:firefox": "bun --filter=@newsnext/extension run dev:firefox",
    "landing:dev": "bun --filter=@newsnext/landing run dev",
    "landing:build": "bun --filter=@newsnext/landing run build",
    "landing:deploy": "bun --filter=@newsnext/landing run deploy",
    "update-deps": "taze -r -w && bun install",
    "release": "bumpp --recursive --install --all --git-check",
    "build": "bun --filter=@newsnext/sdk run schemas:check && bun --filter=@newsnext/extension run build",
    "build:chrome": "bun --filter=@newsnext/extension run build:chrome",
    "build:firefox": "bun --filter=@newsnext/extension run build:firefox"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "^5.27.1",
    "@eslint/js": "^10.0.1",
    "@newsnext/sdk": "workspace:*",
    "@newsnext/tsconfigs": "workspace:*",
    "@types/bun": "^1.4.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "taze": "^21.3.0",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
