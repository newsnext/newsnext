{
  "name": "newsnext",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MPL-2.0",
  "workspaces": {
    "packages": [
      "apps/**",
      "packages/**",
      "servers/**"
    ],
    "catalog": {
      "@tailwindcss/vite": "^4.1.18",
      "react": "^19.2.1",
      "react-dom": "^19.2.1",
      "tailwindcss": "^4.1.18"
    }
  },
  "scripts": {
    "lint": "bun run --bun eslint .",
    "test": "vitest",
    "dev": "bun --filter=@newsnext/api --filter=@newsnext/extension run dev",
    "dev:api": "bun --filter=@newsnext/api run dev",
    "dev:web": "bun --filter=@newsnext/extension run dev",
    "dev:chrome": "bun --filter=@newsnext/extension run dev:chrome",
    "vercel": "vercel"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "defu": "^6.1.4",
    "dotenv": "^17.2.3",
    "ofetch": "^1.5.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.1",
    "@eslint/js": "^9.39.2",
    "@newsnext/tsconfigs": "workspace:*",
    "@types/bun": "^1.3.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "mockdate": "^3.0.5",
    "tsdown": "^0.17.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "npm:rolldown-vite@7.2.10"
  }
}
