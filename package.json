{
  "name": "newsnext",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MPL-2.0",
  "workspaces": {
    "packages": [
      "apps/**",
      "packages/**",
      "servers/**"
    ],
    "catalog": {
      "@tailwindcss/vite": "^4.1.18",
      "hono": "^4.11.1",
      "react": "^19.2.1",
      "react-dom": "^19.2.1",
      "tailwindcss": "^4.1.18"
    }
  },
  "scripts": {
    "lint": "bun run --bun eslint .",
    "test": "vitest",
    "dev": "bun --filter=@newsnext/api --filter=@newsnext/extension run dev",
    "dev:api": "bun --filter=@newsnext/api run dev",
    "dev:web": "bun --filter=@newsnext/extension run dev",
    "dev:chrome": "bun --filter=@newsnext/extension run dev:chrome",
    "postinstall": "bun --filter=@newsnext/build run build -l warn"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "defu": "^6.1.4",
    "dotenv": "^17.3.1",
    "ofetch": "^1.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.3",
    "@eslint/js": "^9.39.3",
    "@newsnext/tsconfigs": "workspace:*",
    "@types/bun": "^1.3.9",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260221.1",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "mockdate": "^3.0.5",
    "tsdown": "^0.20.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vercel": "^50.22.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.67.0"
  },
  "overrides": {
    "iconv-lite": "^0.7.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "^8.0.0-beta.15"
  }
}
