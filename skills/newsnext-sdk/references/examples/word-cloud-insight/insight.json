{
  "title": "Board Word Cloud",
  "view": { "preset": "word-cloud", "query": "cloud", "sort": "desc" },
  "data": {
    "queries": {
      "recent": { "type": "latest", "limit": 500, "deduplicateBy": "url" }
    }
  },
  "params": {
    "maxWords": { "type": "number", "title": "Max words", "default": 60, "min": 10, "max": 200 }
  },
  "refresh": { "intervalMs": 300000 }
}
