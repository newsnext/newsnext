{
  "title": "Board Word Cloud",
  "color": "purple",
  "width": 3,
  "height": 1,
  "minWidth": 2,
  "minHeight": 1,
  "view": {
    "type": "chart",
    "chart": "word-cloud",
    "query": "cloud",
    "sort": "desc"
  },
  "data": {
    "queries": {
      "recent": {
        "type": "latest",
        "limit": 500,
        "deduplicateBy": "url"
      }
    }
  },
  "params": {
    "window": {
      "type": "select",
      "title": "Time window",
      "default": "24",
      "values": [
        {
          "label": "Last hour",
          "value": "1"
        },
        {
          "label": "Last 24 hours",
          "value": "24"
        },
        {
          "label": "Last 7 days",
          "value": "168"
        },
        {
          "label": "Last 30 days",
          "value": "720"
        }
      ]
    },
    "maxWords": {
      "type": "number",
      "title": "Max words",
      "default": 60,
      "min": 10,
      "max": 200
    }
  },
  "refresh": {
    "intervalMs": 300000
  }
}
